# .env.example — copy to .env and customise per environment

# Site
PUBLIC_SITE_NAME="Lee Santer"
PUBLIC_SITE_LOCALE="en_GB"
PUBLIC_HTML_LANG="en-GB"
PUBLIC_DEFAULT_TITLE="Freelance Web &amp; Brand Designer in Kent"
PUBLIC_DEFAULT_DESCRIPTION="Freelance web and brand designer based in Kent, UK. I create websites, brand identities, and digital experiences for startups, agencies, and growing businesses."
PUBLIC_OG_IMAGE="/og-default.jpg"
PUBLIC_TWITTER=""

# Canonicals / Robots
PUBLIC_SITE_URL="https://example.com"
INDEXING=true

# Branding / Head assets
PUBLIC_THEME_COLOR="##1A1A1A"
PUBLIC_FAVICON="/favicon.svg"
PUBLIC_APPLE_TOUCH_ICON="/apple-touch-icon.png"
PUBLIC_MANIFEST="/site.webmanifest"

# Analytics / Consent
PUBLIC_GTM_ID=""
PUBLIC_CONSENT_VERSION="1"

# Optional: override font preloads used by <FontAssets />
# PUBLIC_FONT_PRELOADS="/fonts/InterVariable.woff2,/fonts/InterVariable-Italic.woff2"