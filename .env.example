# .env.example — copy to .env and customise per environment
# Note: Boolean flags are read as strings by Vite. Use true|false (no quotes).

# ─────────────────────────
# Site / SEO (used by SEO.astro)
# ─────────────────────────
PUBLIC_SITE_NAME="Astro Starter"
PUBLIC_SITE_URL="https://example.com"       # absolute; used for canonicals & sitemaps
PUBLIC_HTML_LANG="en-GB"                     # <html lang>
PUBLIC_SITE_LOCALE="en_GB"                   # for JSON-LD

PUBLIC_DEFAULT_TITLE="Web & Brand Design"
PUBLIC_DEFAULT_DESCRIPTION="Web design, branding, and front-end development."
PUBLIC_OG_IMAGE="/og-default.jpg"            # absolute URL or /path
PUBLIC_TWITTER=""                            # e.g. @leesanter

# Feature flags (SEO.astro)
PUBLIC_ENABLE_RSS=false
PUBLIC_ENABLE_SEARCH=false

# ─────────────────────────
# Indexing / CI toggles
# ─────────────────────────
INDEXING=true                                 # false => robots Disallow + sitemap disabled
STRICT_SERVICES=false                         # true => 404 unknown service keys

# ─────────────────────────
# Branding / Head assets (HeadAssets.astro)
# All are optional; put files in /public and point these at them.
# ─────────────────────────
PUBLIC_THEME_COLOR="#1A1A1A"                  # light theme <meta name="theme-color">
PUBLIC_THEME_COLOR_DARK="#000000"             # optional dark variant

PUBLIC_FAVICON="/favicon.svg"                 # preferred SVG
PUBLIC_FAVICON_ICO="/favicon.ico"             # legacy ICO
PUBLIC_FAVICON_PNG_32="/favicon-32.png"       # PNG fallback (32×32)
PUBLIC_FAVICON_PNG_16="/favicon-16.png"       # PNG fallback (16×16)

PUBLIC_APPLE_TOUCH_ICON="/apple-touch-icon.png"  # 180×180
PUBLIC_MASK_ICON="/safari-pinned-tab.svg"        # monochrome SVG for Safari pinned tab
PUBLIC_MASK_ICON_COLOR="#000000"

PUBLIC_MANIFEST="/site.webmanifest"

# ─────────────────────────
# Fonts (Base.astro → FontAssets.astro)
# ─────────────────────────
# Comma-separated list; overrides the default Inter preloads if set.
# Example: "/fonts/InterVariable.woff2,/fonts/InterVariable-Italic.woff2"
PUBLIC_FONT_PRELOADS=""

# ─────────────────────────
# Analytics / Consent (CookieConsent.astro)
# ─────────────────────────
PUBLIC_GTM_ID=""                              # e.g. GTM-XXXXXXX
PUBLIC_CONSENT_VERSION="1"                    # bump to re-prompt users
