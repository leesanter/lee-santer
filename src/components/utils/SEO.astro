---
/* ======================================================================
   SEO.astro — SEO & social meta

   - Env-driven defaults (see .env.example)
   - Builds canonical from Astro.site (or PUBLIC_SITE_URL fallback)
   - Resolves relative og:image to absolute URL
   - Optional global noindex via PUBLIC_NOINDEX_ALL=true
   - Supports JSON-LD (object or array) and og:image:alt
====================================================================== */

/**
 * .env (see .env.example):
 *   PUBLIC_SITE_NAME, PUBLIC_SITE_LOCALE, PUBLIC_HTML_LANG,
 *   PUBLIC_DEFAULT_TITLE, PUBLIC_DEFAULT_DESCRIPTION,
 *   PUBLIC_OG_IMAGE, PUBLIC_TWITTER, PUBLIC_SITE_URL (optional),
 *   PUBLIC_NOINDEX_ALL (optional: "true" to noindex entire site, e.g. staging)
 *
 * Props:
 * - title?: string (page title, without site name)
 * - description?: string
 * - canonical?: string (absolute URL) – if omitted, built from Astro.site (or PUBLIC_SITE_URL)
 * - ogImage?: string (absolute or path starting with "/")
 * - ogImageAlt?: string
 * - type?: "website" | "article" (default "website")
 * - noindex?: boolean
 * - appendSiteName?: boolean (default true) – appends “ — {SITE_NAME}”
 * - titleSeparator?: string (default " — ")
 * - publishedTime?: ISO (article)
 * - modifiedTime?: ISO (article)
 * - structuredData?: object | object[] (JSON-LD)
 */

import type { ImageMetadata } from "astro";

const ENV = import.meta.env;

const SITE_NAME       = ENV.PUBLIC_SITE_NAME ?? "Site";
const LOCALE          = ENV.PUBLIC_SITE_LOCALE ?? "en_GB";
const HTML_LANG       = ENV.PUBLIC_HTML_LANG ?? "en-GB";
const DEFAULT_TITLE   = ENV.PUBLIC_DEFAULT_TITLE ?? "Website";
const DEFAULT_DESC    = ENV.PUBLIC_DEFAULT_DESCRIPTION ?? "";
const DEFAULT_OG      = ENV.PUBLIC_OG_IMAGE ?? "/og-default.jpg";
const TWITTER         = ENV.PUBLIC_TWITTER ?? "";
const PUBLIC_SITE_URL = ENV.PUBLIC_SITE_URL;
const GLOBAL_NOINDEX  = (ENV.PUBLIC_NOINDEX_ALL ?? "").toLowerCase() === "true";

type Type = "website" | "article";
interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string | ImageMetadata;      // ← allow both
  ogImageAlt?: string;
  type?: Type;
  noindex?: boolean;
  appendSiteName?: boolean;
  titleSeparator?: string;
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: object | object[];
}

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESC,
  canonical,
  ogImage,                                 // ← no default here
  ogImageAlt,
  type = "website",
  noindex = false,
  appendSiteName = false,
  titleSeparator = " | ",
  publishedTime,
  modifiedTime,
  structuredData
} = Astro.props as Props;

const base = Astro.site ?? (PUBLIC_SITE_URL ? new URL(PUBLIC_SITE_URL) : undefined);

// Canonical (unchanged)
let canonicalUrl = canonical;
if (!canonicalUrl && base) {
  canonicalUrl = new URL(Astro.url.pathname + Astro.url.search + Astro.url.hash, base).toString();
}

// Coerce ogImage to a string and fall back to DEFAULT_OG in /public
const ogRaw =
  typeof ogImage === "string" ? ogImage : ogImage?.src ?? DEFAULT_OG;

// Ensure og:image is absolute when possible
function toAbsolute(u: string | undefined) {
  if (!u) return u;
  try {
    return new URL(u).toString(); // already absolute?
  } catch {
    if (base && u.startsWith("/")) return new URL(u, base).toString();
    return u;
  }
}
const ogImageResolved = toAbsolute(ogRaw);

const finalTitle = appendSiteName && title
  ? `${title}${titleSeparator}${SITE_NAME}`
  : (title || SITE_NAME);

const isArticle = type === "article";
const shouldNoindex = GLOBAL_NOINDEX || noindex;
---

<!-- Note: language is set on <html> in layouts; this meta is just a hint -->
<meta http-equiv="content-language" content={HTML_LANG} />
<title>{finalTitle}</title>

{description && <meta name="description" content={description} />}
{shouldNoindex && <meta name="robots" content="noindex, nofollow" />}

{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

<meta property="og:type" content={type} />
<meta property="og:locale" content={LOCALE} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={finalTitle} />
{description && <meta property="og:description" content={description} />}
{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
{ogImageResolved && <meta property="og:image" content={ogImageResolved} />}
{ogImageResolved && ogImageResolved.startsWith("https://") && <meta property="og:image:secure_url" content={ogImageResolved} />}
{ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

<meta name="twitter:card" content="summary_large_image" />
{TWITTER && <meta name="twitter:site" content={TWITTER} />}
<meta name="twitter:title" content={finalTitle} />
{description && <meta name="twitter:description" content={description} />}
{ogImageResolved && <meta name="twitter:image" content={ogImageResolved} />}

{isArticle && publishedTime && <meta property="article:published_time" content={publishedTime} />}
{isArticle && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

{structuredData && (
  Array.isArray(structuredData)
    ? structuredData.map((obj) => <script type="application/ld+json">{JSON.stringify(obj)}</script>)
    : <script type="application/ld+json">{JSON.stringify(structuredData)}</script>
)}
