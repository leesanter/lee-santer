---
/** Smart SEO with auto title templating + JSON-LD
 * Env expected (set in .env / CI):
 *  PUBLIC_SITE_NAME
 *  PUBLIC_SITE_URL              e.g. https://leesanter.co.uk
 *  PUBLIC_DEFAULT_TITLE         (optional)
 *  PUBLIC_DEFAULT_DESCRIPTION
 *  PUBLIC_OG_IMAGE              (optional absolute or /path)
 *  PUBLIC_TWITTER               e.g. @leesanter (optional)
 *  PUBLIC_HTML_LANG             e.g. en-GB (optional; default en-GB)
 *  PUBLIC_ENABLE_SEARCH         true|false (optional; default false)
 *  PUBLIC_ENABLE_RSS            true|false (optional; default false)
 *  INDEXING=true|false          (robots)
 *
 * Props:
 *  - title?: string
 *  - description?: string
 *  - image?: string | ImageMetadata  // og:image; absolute or /path or ESM image
 *  - canonical?: string              // absolute; defaults to SITE_URL + pathname
 *  - noindex?: boolean
 *  - type?: 'website'|'article'|'creativework' (default 'website')
 *  - publishedTime?: string|Date     // for article/creativework
 *  - author?: string                 // for article
 *  - appendSiteName?: boolean|'auto' // default 'auto'
 *  - titleTemplate?: string          // e.g. '%s | Freelance Web & Brand Designer in Kent'
 *  - structuredData?: Record<string,any> | Record<string,any>[]
 */

import type { ImageMetadata } from 'astro';
import { getSiteSettings } from '../../lib/content';
const settings = await getSiteSettings();

type Props = {
	title?: string;
	description?: string;
	modifiedTime?: string | Date;
	image?: string | ImageMetadata;
	canonical?: string;
	noindex?: boolean;
	type?: 'website' | 'article' | 'creativework';
	publishedTime?: string | Date;
	author?: string;
	appendSiteName?: boolean | 'auto';
	titleTemplate?: string;
	structuredData?: any | any[];
};

const props = Astro.props as Props;

const SITE_NAME = settings?.siteName ?? import.meta.env.PUBLIC_SITE_NAME ?? '';
const SITE_URL = import.meta.env.PUBLIC_SITE_URL ?? settings?.siteUrl ?? '';
const DEFAULT_TITLE = import.meta.env.PUBLIC_DEFAULT_TITLE ?? SITE_NAME;
const DEFAULT_DESC =
	settings?.defaultDescription ?? import.meta.env.PUBLIC_DEFAULT_DESCRIPTION ?? '';
const DEFAULT_OG = settings?.defaultOgImage ?? import.meta.env.PUBLIC_OG_IMAGE ?? '';
const TWITTER = (settings?.twitterHandle ?? import.meta.env.PUBLIC_TWITTER ?? '').trim();
const INDEXING = String(import.meta.env.INDEXING ?? 'true').toLowerCase() !== 'false';

const HTML_LANG = import.meta.env.PUBLIC_HTML_LANG ?? 'en-GB';
const OG_LOCALE = HTML_LANG.replace('-', '_');

const ENABLE_SEARCH =
	String(import.meta.env.PUBLIC_ENABLE_SEARCH ?? 'false').toLowerCase() === 'true';
const ENABLE_RSS = String(import.meta.env.PUBLIC_ENABLE_RSS ?? 'false').toLowerCase() === 'true';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';

/* Title building */
const baseTitle = (props.title?.trim() || (isHome ? SITE_NAME : DEFAULT_TITLE)).trim();
const includesSiteName = (t: string) =>
	SITE_NAME && t.toLowerCase().includes(SITE_NAME.toLowerCase());

let fullTitle = baseTitle;
const mode = props.appendSiteName ?? 'auto';

if (props.titleTemplate) {
	// Explicit template wins. Replace %s with the baseTitle (or site name if empty)
	fullTitle = props.titleTemplate.replace('%s', baseTitle || SITE_NAME);
} else if (mode === true) {
	fullTitle =
		includesSiteName(baseTitle) || !SITE_NAME ? baseTitle : `${baseTitle} | ${SITE_NAME}`;
} else if (mode === 'auto') {
	if (isHome) {
		// Home: prefer just the site name (no duplication)
		fullTitle = SITE_NAME || baseTitle;
	} else {
		fullTitle =
			includesSiteName(baseTitle) || !SITE_NAME ? baseTitle : `${baseTitle} | ${SITE_NAME}`;
	}
} else {
	// mode === false
	fullTitle = baseTitle;
}

/* Description */
const description = props.description?.trim() || DEFAULT_DESC;

if (import.meta.env.DEV) {
	if (fullTitle.length > 60) {
		console.warn(`[SEO] Title > 60 chars (${fullTitle.length}): ${fullTitle}`);
	}
	if (description && description.length > 160) {
		console.warn(`[SEO] Description > 160 chars (${description.length}).`);
	}
}

/* Modified */
const modifiedISO = props.modifiedTime
	? (typeof props.modifiedTime === 'string'
			? new Date(props.modifiedTime)
			: props.modifiedTime
		).toISOString()
	: undefined;

/* Canonical */
function toAbs(u?: string) {
	if (!u) return undefined;
	try {
		return new URL(u, SITE_URL).href;
	} catch {
		return u;
	}
}
const canonical =
	props.canonical || (SITE_URL ? new URL(Astro.url.pathname, SITE_URL).href : undefined);

/* OG image -> absolute URL (+ dims if ImageMetadata) */
let ogImage: string | undefined;
let ogImageWidth: number | undefined;
let ogImageHeight: number | undefined;

const img = props.image;
if (typeof img === 'string') {
	ogImage = toAbs(img);
} else if (img && typeof img === 'object' && 'src' in img) {
	const im = img as ImageMetadata;
	ogImage = toAbs(im.src);
	ogImageWidth = im.width;
	ogImageHeight = im.height;
} else if (DEFAULT_OG) {
	ogImage = toAbs(DEFAULT_OG);
}

/* Robots */
const robots = props.noindex || !INDEXING ? 'noindex, nofollow' : 'index, follow';

/* Open Graph basics */
const ogType = props.type ?? 'website';

/* JSON-LD */
const ld: any[] = [];

// Organization (logo becomes absolute if provided in settings)
const orgLogoAbs = settings?.brandLogoPath ? toAbs(settings.brandLogoPath) : undefined;

if (SITE_NAME || SITE_URL) {
	ld.push({
		'@context': 'https://schema.org',
		'@type': 'Organization',
		name: SITE_NAME || undefined,
		url: SITE_URL || undefined,
		logo: orgLogoAbs || undefined,
	});
	const websiteLd: any = {
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_NAME || undefined,
		url: SITE_URL || undefined,
	};
	if (ENABLE_SEARCH && SITE_URL) {
		websiteLd.potentialAction = {
			'@type': 'SearchAction',
			target: `${SITE_URL}/search?q={query}`,
			'query-input': 'required name=query',
		};
	}
	ld.push(websiteLd);
}

const publishedISO = props.publishedTime
	? (typeof props.publishedTime === 'string'
			? new Date(props.publishedTime)
			: props.publishedTime
		).toISOString()
	: undefined;

if (ogType === 'article') {
	ld.push({
		'@context': 'https://schema.org',
		'@type': 'Article',
		headline: baseTitle,
		datePublished: publishedISO,
		author: props.author ? { '@type': 'Person', name: props.author } : undefined,
		image: ogImage ? [ogImage] : undefined,
		mainEntityOfPage: canonical ? { '@type': 'WebPage', '@id': canonical } : undefined,
	});
} else if (ogType === 'creativework') {
	ld.push({
		'@context': 'https://schema.org',
		'@type': 'CreativeWork',
		name: baseTitle,
		datePublished: publishedISO,
		image: ogImage ? [ogImage] : undefined,
		url: canonical,
	});
}

// Allow pages to add/override JSON-LD
if (props.structuredData) {
	if (Array.isArray(props.structuredData)) ld.push(...props.structuredData);
	else ld.push(props.structuredData);
}

/* RSS feed (optional; avoid broken link if feed is removed) */
const rssHref = ENABLE_RSS
	? SITE_URL
		? new URL('/rss.xml', SITE_URL).href
		: '/rss.xml'
	: undefined;
---

<!-- Core -->
<title>{fullTitle}</title>
{description && <meta name="description" content={description} />}

{props.author && <meta name="author" content={props.author} />}
{
	publishedISO && (ogType === 'article' || ogType === 'creativework') && (
		<meta property="article:published_time" content={publishedISO} />
	)
}
{
	modifiedISO && (ogType === 'article' || ogType === 'creativework') && (
		<meta property="article:modified_time" content={modifiedISO} />
	)
}

<!-- Canonical + robots -->
{canonical && <link rel="canonical" href={canonical} />}
<meta name="robots" content={robots} />

<!-- Feed discovery (optional) -->
{
	rssHref && (
		<link rel="alternate" type="application/rss+xml" title="Insights — RSS" href={rssHref} />
	)
}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content={ogType} />
{canonical && <meta property="og:url" content={canonical} />}
{ogImage && <meta property="og:image" content={ogImage} />}
{ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
<meta property="og:locale" content={OG_LOCALE} />

<!-- Twitter -->
{TWITTER && <meta name="twitter:site" content={TWITTER} />}
{TWITTER && <meta name="twitter:creator" content={TWITTER} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{description && <meta name="twitter:description" content={description} />}
{ogImage && <meta name="twitter:image" content={ogImage} />}

<!-- JSON-LD -->
{ld.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />}
