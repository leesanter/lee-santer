---
/* ======================================================================
   FontAssets.astro — font preloads / preconnects (shared by layouts)
   - No env usage (robust with all bundlers)
   - Defaults to local Inter variable files in /public/fonts
   - You can override via the `files` prop if needed
     <FontAssets files={["/fonts/Your.woff2", "/fonts/Your-Italic.woff2"]} />
====================================================================== */

const { files = ['/fonts/OpenSans-Semibold.woff2', '/fonts/HelveticaNeue-Medium.otf'] } =
	Astro.props as { files?: string[] };
---

{files.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
