---
import type { CollectionEntry } from 'astro:content';
import InsightCard from '../molecules/InsightCard.astro';
import { getAllPosts, getLatestInsights } from '../../lib/content';

interface Props {
	/**
	 * When provided (e.g. on /insights listing), render exactly these entries.
	 * When omitted, this component can self-fetch for home/sections.
	 */
	entries?: CollectionEntry<'insights'>[];
	/** Limit when self-fetching (e.g. show latest N on home). */
	limit?: number;
	/** Include only these slugs when self-fetching. */
	includeSlugs?: string[];
	/** Exclude these slugs when self-fetching. */
	excludeSlugs?: string[];
}

const { entries: injected, limit, includeSlugs = [], excludeSlugs = [] } = Astro.props as Props;

let list: CollectionEntry<'insights'>[] = [];

if (Array.isArray(injected)) {
	list = injected;
} else if (includeSlugs.length > 0) {
	const all = await getAllPosts();
	list = all.filter((p) => includeSlugs.includes(p.slug));
} else if (typeof limit === 'number') {
	list = await getLatestInsights(limit);
} else {
	list = await getAllPosts();
}

if (excludeSlugs.length) {
	list = list.filter((p) => !excludeSlugs.includes(p.slug));
}

const hasItems = list.length > 0;
---

{
	!hasItems ? (
		<p class="muted">No posts yet.</p>
	) : (
		<ul class="post-list" aria-label="Insights">
			{list.map((p) => (
				<li>
					<InsightCard entry={p} />
				</li>
			))}
		</ul>
	)
}

<style lang="scss">
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--size--large);
	}
	@media (min-width: 720px) {
		.post-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1100px) {
		.post-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
