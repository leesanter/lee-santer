---
import type { CollectionEntry } from 'astro:content';
import {
  getAllWorkTestimonials,
  getTestimonialsForWork,
  type TestimonialVM,
} from '../../lib/content';

interface Props {
  /** Case-study usage: show this case’s testimonial (first one if multiple) */
  workEntry?: CollectionEntry<'work'>;

  /** Home/other pages: optional pool controls */
  includeWorkSlugs?: string[];
  excludeWorkSlugs?: string[];
  entries?: TestimonialVM[];        // optional manual pool

  /** Display options */
  showWorkLink?: boolean;           // default: true if not on a work page
  randomClient?: boolean;           // default: true when NOT rendering a case
}

const {
  workEntry,
  includeWorkSlugs = [],
  excludeWorkSlugs = [],
  entries,
} = Astro.props as Props;

const onWorkPage = Boolean(workEntry);
const showWorkLink = (Astro.props as Props).showWorkLink ?? !onWorkPage;
const randomClient = (Astro.props as Props).randomClient ?? !onWorkPage;

let source: TestimonialVM[] = [];

if (workEntry) {
  // Case study page → stable, first testimonial only
  source = getTestimonialsForWork(workEntry);
} else if (entries?.length) {
  source = entries;
} else if (includeWorkSlugs.length) {
  const all = await getAllWorkTestimonials();
  source = all.filter((t) => includeWorkSlugs.includes(t.workSlug));
} else {
  source = await getAllWorkTestimonials();
}
if (excludeWorkSlugs.length) {
  source = source.filter((t) => !excludeWorkSlugs.includes(t.workSlug));
}

// SSR fallback = first item (good for bots & no-JS)
const first = source[0];
const payload = JSON.stringify(source);
---


    <div class="stack small center">

      {first ? (
        <figure class="testimonial" data-spot>
          <blockquote class="quote" data-quote>{first.quote}</blockquote>
          <figcaption class="who" data-caption>
            {first.name}{first.role ? `, ${first.role}` : ''}{first.company ? `, ${first.company}` : ''}
            {showWorkLink && (
              <Fragment>
                {' · '}
                <a data-work href={`/work/${first.workSlug}`}>{first.workTitle}</a>
              </Fragment>
            )}
          </figcaption>
        </figure>
      ) : (
        <p class="muted">No testimonials yet.</p>
      )}

      {/* Randomize on refresh (home/other pages only) */}
      {!onWorkPage && randomClient && source.length > 1 && (
        <Fragment>
          <!-- JSON payload lives right before the script -->
          <script is:inline type="application/json" data-testimonials set:html={payload} />
          <script is:inline>
            (function () {
              try {
                // Scope everything to this component instance
                var dataEl = document.currentScript && document.currentScript.previousElementSibling;
                if (!dataEl) return;
                var list = JSON.parse(dataEl.textContent || '[]');
                if (!Array.isArray(list) || list.length < 2) return;

                var i = Math.floor(Math.random() * list.length);
                var t = list[i];

                // Find the nearest section hosting this block
                var root = dataEl.closest('section') || document;

                var q = root.querySelector('[data-quote]');
                var c = root.querySelector('[data-caption]');
                var w = root.querySelector('[data-work]');

                if (q) q.textContent = t.quote || '';
                if (c) {
                  var cap = t.name || '';
                  if (t.role) cap += ', ' + t.role;
                  if (t.company) cap += ', ' + t.company;
                  if (w) cap += ' · ';
                  c.textContent = cap;
                }
                if (w) {
                  w.setAttribute('href', '/work/' + t.workSlug);
                  w.textContent = t.workTitle;
                }
              } catch (e) { /* no-op */ }
            })();
          </script>
        </Fragment>
      )}
    </div>


<style>
  .testimonial { max-width: 72ch; margin-inline: auto; }
  .quote { font-size: clamp(1.125rem, 2.8vw, 1.75rem); line-height: 1.5; margin: 0 0 .75rem 0; }
  .who { color: var(--text-muted-colour); }
</style>
