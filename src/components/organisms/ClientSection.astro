---
import type { CollectionEntry } from 'astro:content';
import {
  getAllWorkTestimonials,
  getTestimonialsForWork,
  hasTestimonials,
  getRandomTestimonial,
  type TestimonialVM,
} from '../../lib/content';
import TestimonialQuote from '../atoms/TestimonialQuote.astro';
import LogosRow from '../atoms/LogosRow.astro';

interface Props {
  heading?: string;

  // Pinned mode (case page)
  workEntry?: CollectionEntry<'work'>;

  // Pooled mode (home/about/etc.)
  includeWorkSlugs?: string[];
  excludeWorkSlugs?: string[];
  entries?: TestimonialVM[];
  random?: boolean;         // default true

  // Presentation
  showWorkLink?: boolean;   // default: !workEntry
  id?: string;

  // Logos
  logos?: Parameters<typeof LogosRow>[0]['logos'];
  showLogos?: boolean;      // default true
}

const {
  heading = 'Driven brands, no matter the industry.',
  workEntry,
  includeWorkSlugs = [],
  excludeWorkSlugs = [],
  entries,
  random = true,
  showWorkLink = !workEntry,
  id = 'clients',
  logos,
  showLogos = true,
} = Astro.props as Props;

const onWorkPage = Boolean(workEntry);

// Build testimonial pool
let pool: TestimonialVM[] = [];
if (workEntry) {
  pool = hasTestimonials(workEntry) ? getTestimonialsForWork(workEntry) : [];
} else if (entries?.length) {
  pool = entries;
} else if (includeWorkSlugs.length) {
  const all = await getAllWorkTestimonials();
  pool = all.filter((t) => includeWorkSlugs.includes(t.workSlug));
} else {
  pool = await getAllWorkTestimonials();
}
if (excludeWorkSlugs.length) {
  pool = pool.filter((t) => !excludeWorkSlugs.includes(t.workSlug));
}

// SSR pick
const ssrPick =
  onWorkPage
    ? (pool[0] ?? null)
    : (random ? getRandomTestimonial(pool) : (pool[0] ?? null));

const canRandomize = !onWorkPage && random && pool.length > 1;
const payload = JSON.stringify(pool);
---

<section class="section" id={id} data-scheme="light">
  <div class="container container--large">
    <div class="stack large center">
      {heading && <h2 class="h2">{heading}</h2>}

      {ssrPick ? (
        <div class="testimonial-spot" data-spot>
          <TestimonialQuote
            quote={ssrPick.quote}
            name={ssrPick.name}
            role={ssrPick.role}
            company={ssrPick.company}
            workTitle={ssrPick.workTitle}
            workSlug={ssrPick.workSlug}
            showWorkLink={showWorkLink}
          />
        </div>
      ) : (
        !onWorkPage && <p class="muted">No testimonials yet.</p>
      )}

      {showLogos && <LogosRow logos={logos} />}
    </div>
  </div>

  {canRandomize && (
    <Fragment>
      <script is:inline type="application/json" data-testimonials set:html={payload} />
      <script is:inline>
        (function () {
          try {
            var dataEl = document.currentScript && document.currentScript.previousElementSibling;
            if (!dataEl) return;
            var list = JSON.parse(dataEl.textContent || '[]');
            if (!Array.isArray(list) || list.length < 2) return;

            var pick = Math.floor(Math.random() * list.length);
            var t = list[pick];

            var root = dataEl.closest('section') || document;
            var spot = root.querySelector('[data-spot]');
            if (!spot || !t) return;

            var quote = spot.querySelector('.quote');
            var who = spot.querySelector('.who');
            var link = spot.querySelector('a[href^="/work/"]');

            if (quote) quote.textContent = '“' + (t.quote || '') + '”';
            if (who) {
              var cap = (t.name || '');
              if (t.role) cap += ', ' + t.role;
              if (t.company) cap += ', ' + t.company;
              if (link) cap += ' · ';
              who.textContent = cap;
            }
            if (link) {
              link.setAttribute('href', '/work/' + t.workSlug);
              link.textContent = t.workTitle;
            }
          } catch (e) { /* no-op */ }
        })();
      </script>
    </Fragment>
  )}
</section>

<style>
  h2 {
    max-width: 24ch;
  }
  .center { text-align: center; align-self: center;}
  .testimonial-spot { margin-block: var(--size--medium); }
</style>
