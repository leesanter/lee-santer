---
/* ======================================================================
   SiteHeader.astro — sticky header with dropdowns + mobile menu
   Transparent: forced via overlay ('dark'|'light') or auto-samples BG under header
   Solid: always pins to light for readability
====================================================================== */
import LogoRaw from '../../assets/brand/wordmark.svg?raw';

const ENV = import.meta.env;
const SITE_NAME = ENV.PUBLIC_SITE_NAME ?? 'Site';

/** Types */
type NavChild = { label: string; href: string; isActive?: boolean };
type NavItem = {
	label: string;
	href: string;
	children?: NavChild[];
	isActive?: boolean;
	isActiveParent?: boolean;
};
type CTA = { label: string; href: string };

interface Props {
	logoHref?: string;
	logoAlt?: string;
	nav?: NavItem[];
	cta?: CTA; // omit to hide CTA
	transparent?: boolean; // transparent at top (default true)
	overlay?: 'auto' | 'dark' | 'light'; // preferred prop (transparent phase only)
	headerOverlay?: 'auto' | 'dark' | 'light'; // legacy alias
}

/** Props + defaults */
const props = Astro.props as Props;

const logoHref = props.logoHref ?? '/';
const logoAlt = props.logoAlt ?? SITE_NAME;
const transparent = props.transparent ?? true;
// prefer 'overlay', fall back to 'headerOverlay', default to 'auto'
const overlay = (props.overlay ?? props.headerOverlay ?? 'auto') as 'auto' | 'dark' | 'light';

const defaultNav: NavItem[] = [
	{
		label: 'Services',
		href: '/services',
		children: [
			{ label: 'Web Design', href: '/services/website-design' },
			{ label: 'eCommerce', href: '/services/ecommerce-website-development-design' },
			{ label: 'Web Apps', href: '/services/web-app-development' },
		],
	},
	{ label: 'About', href: '/about' },
	{ label: 'Work', href: '/work' },
	{ label: 'Contact', href: '/contact' },
];

const nav: NavItem[] = props.nav ?? defaultNav;
const ctaBtn: CTA | null = props.cta ?? { label: 'Get a quote', href: '/contact' };

/** Active route state */
const currentPath = Astro.url.pathname.replace(/\/$/, '');
const normalize = (href: string) => href.replace(/\/$/, '');

const navWithState: NavItem[] = nav.map((item, i) => {
	const isActive = normalize(item.href) === currentPath;
	const children: NavChild[] = (item.children ?? []).map((c) => ({
		...c,
		isActive: normalize(c.href) === currentPath,
	}));
	const isActiveParent = children.some((c) => c.isActive);
	return { ...item, isActive, isActiveParent, children };
});
---

<header
	data-header
	data-overlay={overlay}
	class={`site-header${transparent ? ' is-transparent' : ''}`}
	role="banner"
>
	<div class="site-header__inner container container--large">
		<!-- Branding -->
		<a href={logoHref} class="site-header__brand" aria-label={`${logoAlt} — Home`}>
			<span class="sr-only">{logoAlt}</span>
			<span class="logo" aria-hidden="true" set:html={LogoRaw} />
		</a>

		<!-- Primary nav -->
		<nav class="site-nav" aria-label="Main">
			<button
				class="nav-toggle"
				data-toggle
				aria-controls="main-menu"
				aria-expanded="false"
				aria-label="Toggle navigation"
			>
				<span class="nav-toggle__bar"></span>
				<span class="nav-toggle__bar"></span>
				<span class="nav-toggle__bar"></span>
			</button>

			<div class="site-nav__panel" id="main-menu" data-menu aria-hidden="true">
				<ul class="menu root">
					{
						navWithState.map((item, i) => {
							const hasChildren =
								Array.isArray(item.children) && item.children.length > 0;
							const itemClass = [
								'menu__item',
								hasChildren ? 'has-children' : '',
								item.isActive ? 'is-active' : '',
								item.isActiveParent ? 'is-active-parent' : '',
							]
								.filter(Boolean)
								.join(' ');
							const subId = `submenu-${i}`;
							return (
								<li class={itemClass}>
									<div class="menu__linkwrap">
										<a
											href={item.href}
											aria-current={item.isActive ? 'page' : undefined}
											class="menu__link"
										>
											{item.label}
										</a>

										{hasChildren && (
											// Mobile-only disclosure (keeps parent link clickable)
											<button
												class="submenu-toggle"
												aria-controls={subId}
												aria-expanded="false"
												aria-label={`Toggle ${item.label} submenu`}
												data-subtoggle
											>
												<svg
													width="16"
													height="16"
													viewBox="0 0 24 24"
													aria-hidden="true"
												>
													<path
														d="M6 9l6 6 6-6"
														fill="none"
														stroke="currentColor"
														stroke-width="2"
														stroke-linecap="round"
													/>
												</svg>
											</button>
										)}
									</div>

									{hasChildren && (
										<ul
											class="menu sub"
											id={subId}
											aria-label={`${item.label} submenu`}
										>
											{item.children!.map((child) => (
												<li
													class={`menu__item ${child.isActive ? 'is-active' : ''}`}
												>
													<a
														href={child.href}
														class="menu__link"
														aria-current={
															child.isActive ? 'page' : undefined
														}
													>
														{child.label}
													</a>
												</li>
											))}
										</ul>
									)}
								</li>
							);
						})
					}

					{
						ctaBtn && (
							<li class="menu__item menu__cta">
								<a href={ctaBtn.href} class="btn btn--sm">
									{ctaBtn.label}
								</a>
							</li>
						)
					}
				</ul>
			</div>
		</nav>
	</div>
</header>

<style lang="scss">
	/* Header-scoped colour semantics (inherit global [data-scheme] unless solid or forced) */
	.site-header {
		--nav-bg-colour: transparent;
		--nav-panel-bg-colour: var(--bg-colour);
		--nav-link-colour: var(--heading-colour);
		--nav-link-active-colour: var(--palette--primary);
		--nav-border-colour: var(--border-colour);
		--nav-icon-colour: var(--nav-link-colour);
		--nav-hover-bg-colour: color-mix(
			in srgb,
			var(--nav-link-colour) 10%,
			var(--nav-panel-bg-colour)
		);
	}

	.site-header[data-scheme='light'] {
		--nav-link-colour: var(--palette--neutral-900);
		--nav-icon-colour: var(--nav-link-colour);
		--nav-panel-bg-colour: var(--palette--white);
	}
	.site-header[data-scheme='dark'] {
		--nav-link-colour: var(--palette--white);
		--nav-icon-colour: var(--nav-link-colour);
		--nav-panel-bg-colour: var(--palette--neutral-900);
	}

	$linkSizeDesktop: var(--size--regular);
	$linkSizeMobile: $linkSizeDesktop;

	.site-header {
		--header-pad-y: var(--size--small);
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		background: transparent;
		transition:
			background-color var(--ui-duration) var(--ui-ease),
			box-shadow var(--ui-duration) var(--ui-ease),
			transform var(--ui-duration) var(--ui-ease);
		will-change: background-color, box-shadow;

		&.has-bg {
			background: var(--nav-panel-bg-colour);
			box-shadow: 0 1px 0 color-mix(in oklab, var(--nav-link-colour), white 85%);
		}
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: var(--header-pad-y);
		gap: var(--size--small);
	}

	.site-header__brand {
		display: inline-flex;
		align-items: center;
		min-height: 2rem;
		text-decoration: none;
		color: var(--nav-link-colour);
		position: relative;
		z-index: 1002;
	}
	.site-header__brand .logo :global(svg) {
		display: block;
		height: 1.5rem;
		width: auto;
	}

	.site-nav {
		position: relative;
		z-index: 1000;
	}
	.nav-toggle {
		appearance: none;
		background: none;
		border: 1px solid transparent;
		padding: 0.5rem;
		border-radius: 0.5rem;
		cursor: pointer;
		display: flex;
		flex-direction: column;
		gap: 4px;
		align-items: center;
		justify-content: center;
		position: relative;
		z-index: 1002;
		pointer-events: auto;
	}
	.nav-toggle:focus-visible {
		box-shadow: 0 0 0 3px var(--focus-ring-colour);
		outline: none;
	}
	.nav-toggle__bar {
		width: 22px;
		height: 2px;
		background: var(--nav-icon-colour);
		transition:
			transform var(--ui-duration) var(--ui-ease),
			opacity var(--ui-duration) var(--ui-ease);
	}

	.site-nav__panel {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		min-height: 100dvh;
		z-index: 1001;
		background: var(--nav-panel-bg-colour);
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		overscroll-behavior: contain;
		transform: translateY(-4%);
		opacity: 0;
		pointer-events: none;
		transition:
			opacity var(--ui-duration) var(--ui-ease),
			transform var(--ui-duration) var(--ui-ease);
		padding-top: calc(var(--header-height, 56px) + var(--size--large));
		padding-bottom: max(var(--size--large), env(safe-area-inset-bottom));
		padding-left: max(var(--container--pad-x), env(safe-area-inset-left));
		padding-right: max(var(--container--pad-x), env(safe-area-inset-right));
	}

	.menu.root {
		display: grid;
		gap: var(--size--small);
		list-style: none;
		margin: 0;
		padding: 0;
		height: 100%;
	}
	.menu.sub {
		list-style: none;
		margin: 0;
		padding: 0.25rem 0 0.5rem 0.75rem;
		display: none;
		gap: 0.25rem;
	}
	.menu__cta {
		margin-top: 100%;
		.btn {
			width: 100%;
		}
	}
	.menu__linkwrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.menu__link {
		text-decoration: none;
		color: var(--nav-link-colour);
		padding: 0.375rem 0;
		display: inline-flex;
		align-items: center;
	}
	.menu__item.is-active > .menu__link,
	.menu__item.is-active-parent > .menu__link {
		color: var(--nav-link-active-colour);
		font-weight: 600;
	}

	.submenu-toggle {
		appearance: none;
		border: 1px solid
			color-mix(in srgb, var(--nav-border-colour) 65%, var(--nav-panel-bg-colour));
		background: var(--nav-panel-bg-colour);
		border-radius: 0.375rem;
		inline-size: 2rem;
		block-size: 2rem;
		display: inline-grid;
		place-items: center;
	}
	.submenu-toggle:focus-visible {
		box-shadow: 0 0 0 3px var(--focus-ring-colour);
		outline: none;
	}

	.site-nav.is-open .site-nav__panel {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
		visibility: visible;
	}
	.site-nav.is-open .nav-toggle__bar:nth-child(1) {
		transform: translateY(6px) rotate(45deg);
	}
	.site-nav.is-open .nav-toggle__bar:nth-child(2) {
		opacity: 0;
	}
	.site-nav.is-open .nav-toggle__bar:nth-child(3) {
		transform: translateY(-6px) rotate(-45deg);
	}
	.menu__item.is-open > .menu__linkwrap > .submenu-toggle {
		border-color: var(--nav-link-active-colour);
	}
	.menu__item.is-open > .menu.sub {
		display: grid;
	}

	@media (min-width: 992px) {
		.nav-toggle {
			display: none;
		}
		.site-nav__panel {
			position: static;
			transform: none;
			opacity: 1;
			pointer-events: auto;
			background: transparent;
			padding: 0;
			min-height: auto;
			overflow: visible;
			visibility: visible;
		}
		.menu.root {
			display: flex;
			align-items: center;
			gap: var(--size--medium);
			height: auto;
		}
		.menu__link {
			font-size: $linkSizeDesktop;
		}
		.menu__cta {
			margin-left: var(--size--small);
			margin-top: auto;
			.btn {
				width: auto;
			}
		}

		.menu__item.has-children {
			position: relative;
			--submenu-gap: 0.5rem;
		}
		.menu__item.has-children::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			top: 100%;
			height: var(--submenu-gap);
		}
		.menu__item.has-children > .menu__linkwrap > .menu__link {
			display: inline-flex;
			align-items: center;
			gap: 0.35rem;
		}
		.menu__item.has-children > .menu__linkwrap > .menu__link::after {
			content: '▾';
			font-size: 1rem;
			line-height: 1;
			transform-origin: 50% 45%;
			transition:
				transform var(--ui-duration) var(--ui-ease),
				opacity var(--ui-duration) var(--ui-ease);
			opacity: 0.85;
		}

		.menu__item.has-children > .menu.sub {
			position: absolute;
			left: 0;
			top: calc(100% + var(--submenu-gap));
			min-width: 14rem;
			background: var(--nav-panel-bg-colour);
			border: 1px solid var(--nav-border-colour);
			display: none;
			padding: 0.5rem;
			box-shadow: 0 8px 24px color-mix(in srgb, var(--nav-link-colour) 15%, transparent);
			z-index: 10;
		}
		.menu__item.has-children:hover > .menu.sub,
		.menu__item.has-children:focus-within > .menu.sub,
		.menu__item.has-children > .menu.sub:hover {
			display: grid;
			gap: 0.25rem;
		}

		.menu.sub .menu__link {
			padding: 0.375rem 0.5rem;
			border-radius: calc(0.5rem - var(--button-radius));
			width: 100%;
		}
		.menu.sub .menu__link:hover,
		.menu.sub .menu__link:focus-visible {
			background: var(--nav-hover-bg-colour);
			outline: none;
		}
		.menu__item.has-children > .menu__linkwrap > .submenu-toggle {
			display: none;
		}
	}

	/* ScrollListener integration (hide/show on scroll) */
	body.site-scroll--down .site-header {
		transform: translateY(-100%);
	}
	body.site-scroll--up .site-header {
		background: var(--nav-panel-bg-colour);
		box-shadow: 0 1px 0 color-mix(in srgb, var(--nav-link-colour) 12%, transparent);
	}
	body.site-scroll--up .site-header,
	body.site-scroll--inactive .site-header {
		transform: translateY(0);
	}

	body.no-scroll {
		overflow: hidden;
	}
</style>

<script is:inline>
	(function () {
		var header = document.querySelector('[data-header]');
		var nav = document.querySelector('.site-nav');
		var panel = document.querySelector('[data-menu]');
		var toggle = document.querySelector('[data-toggle]');
		var subToggles = Array.prototype.slice.call(document.querySelectorAll('[data-subtoggle]'));
		if (!header || !nav || !panel || !toggle) return;
		if (!toggle.getAttribute('type')) toggle.setAttribute('type', 'button');

		function setHeaderHeight() {
			var h = header.offsetHeight || 56;
			document.documentElement.style.setProperty('--header-height', h + 'px');
		}
		setHeaderHeight();
		requestAnimationFrame(setHeaderHeight);
		window.addEventListener('load', setHeaderHeight);
		window.addEventListener('resize', setHeaderHeight);
		if ('ResizeObserver' in window) new ResizeObserver(setHeaderHeight).observe(header);

		const firstMenuLink = panel.querySelector('.menu.root a');
		function openNav() {
			nav.classList.add('is-open');
			panel.setAttribute('aria-hidden', 'false');
			toggle.setAttribute('aria-expanded', 'true');
			document.body.classList.add('no-scroll');
			firstMenuLink?.focus();
		}
		function closeNav() {
			nav.classList.remove('is-open');
			panel.setAttribute('aria-hidden', 'true');
			toggle.setAttribute('aria-expanded', 'false');
			document.body.classList.remove('no-scroll');
			subToggles.forEach(function (btn) {
				btn.setAttribute('aria-expanded', 'false');
				var li = btn.closest('.menu__item');
				if (li) li.classList.remove('is-open');
			});
			toggle.focus();
		}

		toggle.addEventListener('click', function () {
			nav.classList.contains('is-open') ? closeNav() : openNav();
		});
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape' && nav.classList.contains('is-open')) closeNav();
		});
		subToggles.forEach(function (btn) {
			btn.addEventListener('click', function () {
				var li = btn.closest('.menu__item');
				var expanded = btn.getAttribute('aria-expanded') === 'true';
				btn.setAttribute('aria-expanded', expanded ? 'false' : 'true');
				if (li) li.classList.toggle('is-open', !expanded);
			});
		});
	})();
</script>
