---
import type { CollectionEntry } from 'astro:content';
import InsightCard from '../molecules/InsightCard.astro';
import { getAllPosts, getLatestInsights } from '../../lib/content';

interface Props {
	entries?: CollectionEntry<'insights'>[]; // pass on /insights/[...page]
	limit?: number; // use on Home
	includeSlugs?: string[]; // optional
	excludeSlugs?: string[]; // optional
}

const { entries: injected, limit, includeSlugs = [], excludeSlugs = [] } = Astro.props as Props;

let list: CollectionEntry<'insights'>[] = [];

if (injected?.length) {
	list = injected;
} else if (includeSlugs.length) {
	const all = await getAllPosts();
	list = all.filter((p) => includeSlugs.includes(p.slug));
} else if (typeof limit === 'number') {
	list = await getLatestInsights(limit);
} else {
	list = await getAllPosts();
}
if (excludeSlugs.length) list = list.filter((p) => !excludeSlugs.includes(p.slug));
---

{
	list.length === 0 ? (
		<p class="muted">No posts yet.</p>
	) : (
		<ul class="post-list" role="list">
			{list.map((p) => (
				<li>
					<InsightCard entry={p} />
				</li>
			))}
		</ul>
	)
}

<style lang="scss">
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--size--large);
	}
	@media (min-width: 720px) {
		.post-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (min-width: 1100px) {
		.post-list {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
