---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { readingTimeFromMarkdown } from '../../lib/readingTime';

interface Props {
	entry: CollectionEntry<'insights'>;
}

const { entry } = Astro.props;
const href = `/insights/${entry.slug}`;
const { title, summary, hero, heroAlt = '', date } = entry.data;
const formatted = new Intl.DateTimeFormat('en-GB', {
	day: '2-digit',
	month: 'short',
	year: 'numeric',
}).format(new Date(date));

// ⚠️ entry.body is the raw markdown string from content collections
const { minutes } = readingTimeFromMarkdown(entry.body ?? '');
---

<article class="insight-card">
	<a class="insight-card__link" href={href}>
		<figure class="insight-card__media">
			<Image
				src={hero}
				alt={heroAlt}
				widths={[480, 768, 1024, 1440]}
				sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw"
				loading="lazy"
				decoding="async"
			/>
		</figure>
		<div class="insight-card__content">
			<p class="insight-card__meta">{formatted} · {minutes} min read</p>
			<h3 class="insight-card__title">{title}</h3>
			<p class="insight-card__summary">{summary}</p>
		</div>
	</a>
</article>

<style>
	.insight-card {
		display: block;
	}
	.insight-card__link {
		display: grid;
		gap: 0.5rem;
		text-decoration: none;
		color: inherit;
	}
	.insight-card__media :where(img, picture) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: var(--radius--l, 14px);
	}
	.insight-card__meta {
		margin: 0;
		font-size: 0.9rem;
		color: var(--text-muted-colour, #666);
	}
	.insight-card__title {
		margin: 0;
	}
	.insight-card__summary {
		margin: 0;
		color: var(--text-muted-colour, #555);
	}
</style>
