---
// src/components/molecules/RevealImage.astro
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	image: ImageMetadata;
	alt: string;

	/* Layout */
	widths?: number[];
	sizes?: string;
	/** Optional CSS aspect-ratio, e.g. "3 / 2". If parallax is true and this is omitted, we'll derive it from the image metadata. */
	aspect?: string;

	/* Effects */
	reveal?: boolean; // wipe-on-enter (default: true)
	revealFrom?: 'left' | 'right'; // direction (default: 'right' → wipe moves left)
	revealDuration?: number; // ms (default: 1200)
	parallax?: boolean; // lightweight scroll parallax
	parallaxAmount?: number; // % travel of the image (default 10)

	/* Image loading hints */
	loading?: 'eager' | 'lazy'; // default: 'lazy'
	decoding?: 'async' | 'sync' | 'auto'; // default: 'async'

	/* Styling hook */
	class?: string;
}

const {
	image,
	alt,
	widths = [768, 1280, 1600],
	sizes = '100vw',
	aspect,
	reveal = true,
	revealFrom = 'right',
	revealDuration = 1200,
	parallax = false,
	parallaxAmount = 10,
	loading = 'lazy',
	decoding = 'async',
	class: className = '',
	...attrs
} = Astro.props as Props;

// Keep wrapper non-zero height when parallax (absolute image)
const computedAspect = parallax ? (aspect ?? `${image.width} / ${image.height}`) : aspect;

const rootClass = [
	'image-wrap',
	reveal ? 'has-reveal' : '',
	parallax ? 'has-parallax' : '',
	className,
]
	.filter(Boolean)
	.join(' ');

// Inline style (aspect + reveal vars)
const styleParts: string[] = [];
if (computedAspect) styleParts.push(`aspect-ratio:${computedAspect}`);
// left => wipe moves right (+101%), right => wipe moves left (-101%)
if (reveal) {
	styleParts.push(`--reveal-to-x:${revealFrom === 'left' ? '101%' : '-101%'}`);
	styleParts.push(`--reveal-duration:${revealDuration}ms`);
}
const rootStyle = styleParts.join(';');
---

<figure
	class={rootClass}
	style={rootStyle || undefined}
	data-parallax={parallax ? String(parallaxAmount) : undefined}
	{...attrs}
>
	<Image
		class={parallax ? 'parallax-image' : ''}
		src={image}
		alt={alt}
		widths={widths}
		sizes={sizes}
		loading={loading}
		decoding={decoding}
	/>

	{reveal && <div class="image-revealer" aria-hidden="true" />}
</figure>

<style>
	/* Wrapper */
	.image-wrap {
		position: relative;
		width: 100%;
		display: block;
		overflow: hidden;
	}

	/* Overlay base — only visible when reveal is enabled */
	.image-revealer {
		display: none;
		background: var(--reveal-bg, #fff); /* override site-wide if needed */
	}

	/* Start fully covering so there is something to wipe away */
	.has-reveal .image-revealer {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: block;
		width: 110%;
		height: 100%;
		transform: translate3d(0, 0, 0); /* cover */
		transition: transform var(--reveal-duration, 1200ms) cubic-bezier(0.2, 0.8, 0.2, 1);
		will-change: transform;
	}

	/* Slide the overlay out to reveal the image.
     Direction controlled by --reveal-to-x: 101% (left→right) or -101% (right→left). */
	.has-reveal.is-revealed .image-revealer {
		transform: translate3d(var(--reveal-to-x, -101%), 0, 0);
	}

	/* Parallax image inside masked wrapper */
	.has-parallax .parallax-image {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		width: 100%;
		height: 120%;
		object-fit: cover;
		will-change: transform;
		transform: translate3d(0, 0, 0);
	}
</style>

<script is:inline>
	(function () {
		// Find the figure immediately before this inline script
		const s = document.currentScript;
		/** @type {HTMLElement|null} */
		const root =
			s?.previousElementSibling && s.previousElementSibling.matches('.image-wrap')
				? /** @type {HTMLElement} */ (s.previousElementSibling)
				: s?.previousElementSibling?.closest?.('.image-wrap');

		if (!root) return;

		const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		// ---- Helpers ----
		const revealNow = () => {
			const overlay = /** @type {HTMLElement|null} */ (root.querySelector('.image-revealer'));
			overlay && overlay.getBoundingClientRect(); // force reflow
			requestAnimationFrame(() => {
				requestAnimationFrame(() => root.classList.add('is-revealed'));
			});
		};

		const isInViewport = (el) => {
			const r = el.getBoundingClientRect();
			const vh = window.innerHeight || 0;
			const vw = window.innerWidth || 0;
			return r.bottom > 0 && r.right > 0 && r.top < vh * 0.9 && r.left < vw;
		};

		// ---- Reveal on enter (once) ----
		if (root.classList.contains('has-reveal')) {
			if (prefersReduced) {
				root.classList.add('is-revealed');
			} else {
				const setup = () => {
					if (isInViewport(root)) {
						revealNow(); // already in view on load
						return;
					}
					const io = new IntersectionObserver(
						(entries) => {
							for (const e of entries) {
								if (e.isIntersecting) {
									revealNow();
									io.disconnect();
									break;
								}
							}
						},
						{ rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
					);
					io.observe(root);
				};

				if (document.readyState === 'loading') {
					window.addEventListener('DOMContentLoaded', setup, { once: true });
				} else {
					setup();
				}
			}
		}

		// ---- Lightweight parallax (only while visible) ----
		if (root.classList.contains('has-parallax') && !prefersReduced) {
			const img = /** @type {HTMLElement|null} */ (root.querySelector('.parallax-image'));
			if (!img) return;

			let raf = 0;
			let active = false;
			const amount = parseFloat(root.getAttribute('data-parallax') || '10'); // percent

			const tick = () => {
				raf = 0;
				const rect = root.getBoundingClientRect();
				const vh = window.innerHeight || 0;
				const progress = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
				const offset = (progress - 0.5) * 2 * amount; // -amount..+amount %
				img.style.transform = `translate3d(0, ${offset}%, 0)`;
			};

			const onScroll = () => {
				if (raf) return;
				raf = requestAnimationFrame(tick);
			};

			const start = () => {
				if (active) return;
				active = true;
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll, { passive: true });
				onScroll();
			};

			const stop = () => {
				if (!active) return;
				active = false;
				window.removeEventListener('scroll', onScroll);
				window.removeEventListener('resize', onScroll);
				img.style.transform = '';
			};

			const vis = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) start();
						else stop();
					}
				},
				{ threshold: 0 }
			);
			vis.observe(root);
		}
	})();
</script>
