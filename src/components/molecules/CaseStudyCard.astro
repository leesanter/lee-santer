---
import ImageRevealer from '../atoms/ImageRevealer.astro';
---

<div class="case-study-card">
	<a class="case-study-card_link-block" href="/case-studies/forma">
		<div class="image-wrap case-study">
			<img
				width="1232"
				loading="lazy"
				alt=""
				src="images/forma_thumbnail_1.avif"
				class="parallax-image"
				style="will-change: transform; transform: translate3d(0px, 5.9196%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg); transform-style: preserve-3d;"
			/>
			<ImageRevealer />
		</div>
	</a>
	<div class="case-study-card__meta">
		<h3
			class="case-study-card_meta_title slide-in-right--02"
			style="transform: translate3d(100px, 0px, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg); transform-style: preserve-3d; opacity: 0;"
		>
			Forma
		</h3>
		<p
			class="case-study-card_meta_service fade--up-04"
			style="transform: translate3d(0px, 30%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg); transform-style: preserve-3d; opacity: 0;"
		>
			Content Strategy and Planning<br />User Interface Design<br />Webflow
		</p>
	</div>
	<div class="case-studies__button" style="opacity: 0;">
		<a class="btn btn--light" href="/case-studies/forma">View Case Study</a>
	</div>
</div>
