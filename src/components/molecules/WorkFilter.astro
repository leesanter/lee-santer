---
import { CATEGORIES, toSlug } from '../../lib/categories';

type Props = { active?: string | null; activeClass?: string };
const { active = null, activeClass = 'btn--active' } = Astro.props as Props;

const linkClass = (on: boolean) => `btn btn--sm btn--outline${on ? ` ${activeClass}` : ''}`;
const isAllActive = active == null;
---

<nav class="work-filter" aria-label="Filter">
	<a href="/work" class={linkClass(isAllActive)} aria-current={isAllActive ? 'page' : undefined}>
		All
	</a>

	{
		CATEGORIES.map((cat) => {
			const slug = toSlug(cat);
			const on = active === slug;
			return (
				<a
					href={`/work/${slug}`}
					class={linkClass(on)}
					aria-current={on ? 'page' : undefined}
				>
					{cat}
				</a>
			);
		})
	}
</nav>
