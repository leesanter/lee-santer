---
/* ======================================================================
   PostCard.astro — compact blog teaser card (molecule)
   - Used on /blog listing grids or “latest posts” sections
   - Token-driven spacing/typography; no hard margins (use .stack/.content-layout)
   - Props:
     - href: string (required)
     - title: string (required)
     - description?: string
     - date?: string | Date (ISO is best)
     - readingTime?: string (e.g. "4 min read")
     - tags?: string[]
     - image?: { src: string; alt?: string }  // optional thumbnail
====================================================================== */
const { href, title, description = "", date, readingTime = "", tags = [], image } = Astro.props;

const iso = date ? new Date(date).toISOString() : undefined;
const pretty = date ? new Date(date).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" }) : "";
---

<article class="post-card stack small">
	{
		image && (
			<a href={href} class="post-card__thumb" aria-label={title}>
				<img src={image.src} alt={image.alt ?? ""} loading="lazy" decoding="async" />
			</a>
		)
	}

	<header class="stack tiny">
		<h3 class="h4"><a class="post-card__link" href={href}>{title}</a></h3>

		{
			(pretty || readingTime || tags.length) && (
				<p class="post-card__meta text-small text-mid nowrap">
					{pretty && <time datetime={iso}>{pretty}</time>}
					{pretty && readingTime && <span aria-hidden="true"> · </span>}
					{readingTime && <span>{readingTime}</span>}
					{(pretty || readingTime) && tags.length ? <span aria-hidden="true"> · </span> : null}
					{tags.length ? <span>{tags.join(", ")}</span> : null}
				</p>
			)
		}
	</header>

	{description && <p class="text-regular">{description}</p>}

	<p class="post-card__cta">
		<a class="link-style" href={href} aria-label={`Read: ${title}`}>Read more</a>
	</p>
</article>

<style lang="scss">
	/* ======================================================================
   Styles scoped to PostCard
   - No outer margins; use parent .stack/.content-layout to space items
   - Minimal chrome so it adapts to any grid
====================================================================== */
	.post-card {
		--card-pad: var(--size--small);
		--card-radius: var(--button-radius); /* keep rounded language consistent */

		background: var(--colour--white);
		border: 1px solid var(--border-colour);
		border-radius: var(--card-radius);
		padding: var(--card-pad);

		.post-card__link {
			color: var(--colour--heading);
			text-decoration: none;
		}
		.post-card__link:hover,
		.post-card__link:focus-visible {
			text-decoration: underline;
			outline: none;
		}

		.post-card__meta {
			display: flex;
			gap: 0.25rem;
			align-items: baseline;
			flex-wrap: wrap;
		}

		.post-card__cta {
			margin-top: auto;
		}
	}

	/* Optional thumbnail block (auto aspect without fixed height) */
	.post-card__thumb {
		display: block;
		overflow: hidden;
		border-radius: calc(var(--card-radius) - 2px);
		border: 1px solid var(--border-colour);
	}
	.post-card__thumb img {
		display: block;
		width: 100%;
		height: auto;
	}
</style>
