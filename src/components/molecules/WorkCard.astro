---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

type Case = CollectionEntry<'case-studies'>;
type ServiceLink = { label: string; href?: string | null };

interface Props {
	entry: Case;
	services: ServiceLink[];
}

const { entry, services } = Astro.props as Props;
const href = `/work/${entry.slug}`;
const { title, hero, heroAlt = '' } = entry.data;
---

<article class="work-card">
	<!-- Big linked media -->
	<a class="work-card__media" href={href} aria-label={`View case study: ${title}`}>
		<div class="work-card__image-wrap" data-parallax>
			<Image
				src={hero}
				alt={heroAlt}
				class="work-card__image"
				widths={[640, 960, 1280, 1600]}
				sizes="(min-width: 1100px) 1100px, 92vw"
				loading="lazy"
				decoding="async"
			/>
			<span class="work-card__scrim" aria-hidden="true"></span>
			<!-- optional reveal layer (wired later) -->
			<div class="work-card__revealer" aria-hidden="true" data-reveal></div>
		</div>
	</a>

	<!-- Non-interactive overlay copy -->
	<div class="work-card__overlay text-override-light">
		<h3 class="work-card__title">{title}</h3>
		{
			services.length > 0 && (
				<ul class="work-card__services" role="list">
					{services.map((s) => (
						<li>{s.label}</li>
					))}
				</ul>
			)
		}
	</div>

	<!-- Text CTA bottom-right over the image (separate link; no nesting) -->
	<p class="work-card__cta">
		<a class="work-card__cta-link" href={href}>View case study →</a>
	</p>
</article>

<style lang="scss">
	.work-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--size--medium);
		width: 100%;
		overflow: hidden;
	}

	/* Media block */
	.work-card__media {
		position: relative;
		display: block;
		width: 100%;
		max-height: 90vh;
	}
	.work-card__image-wrap {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		overflow: hidden;
		width: 100%;
		height: 100%;
		aspect-ratio: 3/2;
	}
	.work-card__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 120%;
		object-fit: cover;
		object-position: 50% 50%;
		will-change: transform;
		transform-style: preserve-3d;
	}

	/* Reveal hook (inactive for now) */
	.work-card__revealer {
		display: none;
		position: absolute;
		inset: 0;
		width: 110%;
		height: 100%;
		z-index: 2;
		background: var(--bg-colour);
	}

	/* Overlay copy */
	.work-card__overlay {
		pointer-events: none;
		position: absolute;
		left: var(--size--large);
		right: var(--size--large);
		bottom: var(--size--large);
		z-index: 3;
	}
	.work-card__title {
		color: var(--palette--white);
		margin: 0;
		font-size: var(--font--heading-1);
	}
	.work-card__services {
		color: var(--palette--neutral-600);
		margin: 0.5rem 0 0;
		padding: 0;
		list-style: none;
		line-height: 1.4;
		li {
			font-size: var(--font--large);
		}
	}
	.work-card__services li + li {
		margin-top: 0.15rem;
	}

	/* Text CTA */
	.work-card__cta {
		margin: 0;
		position: absolute;
		right: var(--size--large);
		bottom: var(--size--large);
		z-index: 4;
	}
	.work-card__cta-link {
		color: var(--palette--white);
		text-decoration: none;
		text-underline-offset: 0.12em;
		text-decoration-thickness: from-font;
		font-weight: var(--weight--medium);
		font-size: var(--font--large);
	}
	.work-card__cta-link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* Darken via overlay scrim */
	.work-card__scrim {
		position: absolute;
		inset: 0;
		pointer-events: none;
		background: rgba(0, 0, 0, 0.45); /* ≈ brightness(0.55) */
		transition: opacity 0.2s ease; /* cheap */
	}

	/* Subtle affordance on desktop only (no zoom) */
	@media (hover: hover) {
		.work-card__media:hover .work-card__scrim {
			opacity: 0.5;
		}
	}

	/* Keep your focus ring (no transforms needed) */
	.work-card__media:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
		border-radius: var(--radius--xl, 16px);
	}

	/* Mobile spacing tweaks */
	@media (max-width: 640px) {
		.work-card__overlay {
			left: var(--size--medium);
			right: var(--size--medium);
			bottom: var(--size--medium);
		}
		.work-card__cta {
			right: var(--size--medium);
			bottom: var(--size--medium);
		}
	}
</style>
