---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
	entry: CollectionEntry<'case-studies'>;
	services: { label: string; href: string | null }[];
}

const { entry, services } = Astro.props;
const { data } = entry;
const href = `/work/${entry.slug}`; // ✅ use system slug
---

<article class="work-card">
	<a class="work-card__link" href={href}>
		<figure class="work-card__media">
			<Image
				src={data.hero}
				alt={data.heroAlt}
				widths={[480, 768, 1024, 1440]}
				sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 100vw"
				loading="lazy"
				decoding="async"
			/>
		</figure>
		<div class="work-card__content">
			<h3 class="work-card__title">{data.title}</h3>
			<p class="work-card__summary">{data.summary}</p>
			<p class="work-card__services">
				{
					services.map((s, i) => (
						<>
							{i > 0 && (
								<span class="sep" aria-hidden="true">
									{' '}
									·{' '}
								</span>
							)}
							{s.href ? <a href={s.href}>{s.label}</a> : <span>{s.label}</span>}
						</>
					))
				}
			</p>
		</div>
	</a>
</article>

<style>
	.work-card {
		display: block;
	}
	.work-card__link {
		display: grid;
		gap: 0.5rem;
		text-decoration: none;
		color: inherit;
	}
	.work-card__media :where(img, picture) {
		width: 100%;
		height: auto;
		display: block;
		border-radius: var(--radius--l, 14px);
	}
	.work-card__title {
		margin: 0;
	}
	.work-card__summary {
		margin: 0;
		color: var(--text-muted-colour, #555);
	}
	.work-card__services {
		margin: 0;
		color: var(--text-muted-colour, #666);
		font-size: 0.95rem;
	}
	.work-card__services a {
		text-decoration: underline;
	}
</style>
