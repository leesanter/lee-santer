---
const { href, title, summary, img, alt, chips = [] } = Astro.props;
---

<article class="work-card">
	<a href={href}>
		<img src={img.src} alt={alt} loading="lazy" />
		<h3>{title}</h3>
		<p>{summary}</p>
	</a>
	{
		chips.length > 0 && (
			<p class="chips">
				{chips.map((c) =>
					c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>
				)}
			</p>
		)
	}
</article>
