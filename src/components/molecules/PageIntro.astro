---
/**
 * PageIntro — headline block with optional subtitle/lede/actions.
 * Props:
 *  • title: string
 *  • subtitle?: string
 *  • lede?: string
 *  • align?: 'left' | 'center' (default 'left')
 *  • as?: 'section' | 'div' (default 'section')
 *  • container?: 'small' | 'medium' | 'large' | false (default 'large')
 *  • scheme?: 'light' | 'dark' | 'inherit' (default 'inherit')
 *  • id?: string
 *  • class?: string
 * Slots:
 *  • default (renders under the lede)
 *  • <slot name="actions" /> for buttons/links row
 */

interface Props {
	title: string;
	subtitle?: string;
	lede?: string;
	align?: 'left' | 'center';
	as?: 'section' | 'div';
	container?: 'small' | 'medium' | 'large' | false;
	scheme?: 'light' | 'dark' | 'inherit';
	id?: string;
	class?: string;
}

const {
	title,
	subtitle,
	lede,
	align = 'left',
	as = 'section',
	container = 'large',
	scheme = 'inherit',
	id,
	class: className = '',
} = Astro.props as Props;

const Tag = as; // dynamic tag
const rootClass = `section page-intro ${align === 'center' ? 'is-center' : ''} ${className}`.trim();
const schemeAttr = scheme !== 'inherit' ? scheme : undefined;
const containerClass = container ? `container container--${container}` : ''; // if false, we won't render container div
---

<Tag id={id} class={rootClass} data-scheme={schemeAttr}>
	{
		container ? (
			<div class={containerClass}>
				<div class="page-intro__content">
					{subtitle && <p class="subtitle text-larger">{subtitle}</p>}
					<h1 class="title">{title}</h1>
					{lede && <p class="lede text-large">{lede}</p>}

					<div class="actions">
						<slot name="actions" />
					</div>
					<slot />
				</div>
			</div>
		) : (
			<div class="page-intro__content">
				{subtitle && <p class="subtitle text-larger">{subtitle}</p>}
				<h1 class="title">{title}</h1>
				{lede && <p class="lede text-large">{lede}</p>}

				<div class="actions">
					<slot name="actions" />
				</div>
				<slot />
			</div>
		)
	}
</Tag>

<style lang="scss">
	.page-intro {
		/* spacing comes from .section and .container; keep typography simple */

		.subtitle {
			font-size: var(--font--large);
			color: var(--text-colour);
			margin-bottom: var(--size--xsmall);
		}

		.title {
			margin-bottom: var(--size--medium);
		}

		.lede {
			color: var(--text-colour);
			max-width: 60ch;
			margin-inline: 0; /* centered via parent when is-center */
		}

		.actions {
			display: inline-flex;
			gap: var(--size--medium);
			flex-wrap: wrap;
			margin-top: var(--size--medium);
		}
		.actions:empty {
			display: none;
		}

		&.is-center {
			text-align: center;
			.lede {
				margin-inline: auto;
			}
		}
	}
</style>
