---
interface Props {
	quote: string;
	name: string;
	role?: string;
	company?: string;
	workTitle?: string;
	workSlug?: string;
	showWorkLink?: boolean; // default true off case pages
}

const {
	quote,
	name,
	role,
	company,
	workTitle,
	workSlug,
	showWorkLink = true,
} = Astro.props as Props;
---

<figure class="testimonial">
	<span class="quote">“{quote}”</span>
	<figcaption class="who">
		{name}{role ? `, ${role}` : ''}{company ? `, ${company}` : ''}
		{
			showWorkLink && workSlug && workTitle && (
				<>
					{' · '}
					<a href={`/work/${workSlug}`}>{workTitle}</a>
				</>
			)
		}
	</figcaption>
</figure>

<style>
	.testimonial {
		max-width: 72ch;
		margin-inline: auto;
		text-align: center;

		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--size--medium);
	}
	.quote {
		font-size: var(--font--larger);
		line-height: 1.5;
	}
	.who {
		color: var(--text-muted-colour);
		font-size: var(--font--large);
	}
</style>
