---
import type { ImageMetadata } from 'astro';

type Logo = { name: string; src: string | ImageMetadata; alt?: string; href?: string };

interface Props {
	logos?: Logo[]; // optional manual list; if omitted we auto-scan /src/assets/clients
	heading?: string;
	showHeadingVisuallyHidden?: boolean;
}

const { logos, heading = 'Clients', showHeadingVisuallyHidden = true } = Astro.props as Props;

function labelFromPath(p: string) {
	const n = p
		.split('/')
		.pop()!
		.replace(/\.(svg|png|jpe?g|webp|avif)$/i, '');
	return n.replace(/[-_]/g, ' ');
}

let items: Logo[] = logos ?? [];

if (!items || items.length === 0) {
	// NOTE: glob patterns must be static literals — no variables or template strings.
	const raster = import.meta.glob<{ default: ImageMetadata }>(
		'/src/assets/clients/**/*.{png,jpg,jpeg,webp,avif}',
		{ eager: true }
	);
	const vector = import.meta.glob<{ default: string }>('/src/assets/clients/**/*.svg', {
		eager: true,
		as: 'url',
	});

	items = [
		...Object.entries(raster).map(([p, m]) => ({
			name: labelFromPath(p),
			src: m.default,
			alt: `${labelFromPath(p)} logo`,
		})),
		...Object.entries(vector).map(([p, m]) => ({
			name: labelFromPath(p),
			src: m.default,
			alt: `${labelFromPath(p)} logo`,
		})),
	].sort((a, b) => a.name.localeCompare(b.name));
}
---

<section class="logos">
	<h2 class={`logos__heading ${showHeadingVisuallyHidden ? 'sr-only' : ''}`}>{heading}</h2>
	<ul class="logos__list" role="list">
		{
			items.map((it) => {
				const url = typeof it.src === 'string' ? it.src : (it.src as ImageMetadata).src;
				const img = (
					<img
						src={url}
						alt={it.alt ?? `${it.name} logo`}
						loading="lazy"
						decoding="async"
					/>
				);
				return (
					<li class="logos__item">
						{it.href ? (
							<a href={it.href} aria-label={it.name}>
								{img}
							</a>
						) : (
							img
						)}
					</li>
				);
			})
		}
	</ul>
</section>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	.logos {
		padding-block: var(--size--large);
	}
	.logos__list {
		display: flex;
		gap: clamp(1rem, 3vw, 2.5rem);
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.logos__item img {
		height: 34px;
		width: auto;
		display: block;
		opacity: 0.9;
	}
	.logos__item img:hover {
		opacity: 1;
	}
</style>
