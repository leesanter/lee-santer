---
/** atoms/LogosRow.astro
 * Renders a strip of client logos.
 * Priority: 1) explicit `logos` prop  2) clients.json override  3) auto-glob fallback
 */
type Logo = { src: string; alt?: string; href?: string };

interface Props {
	logos?: Logo[]; // explicit list wins
	class?: string;
	title?: string;
}

const { logos: explicit, class: klass = '', title } = Astro.props as Props;

/* ---------- 2) Optional JSON override ---------- */
let override: { file: string; alt?: string; href?: string }[] = [];
try {
	// If the JSON isn’t present, Vite will fail the import. We guard with try/catch.
	// @ts-ignore – JSON import typing
	const json = await import('../../assets/clients/clients.json');
	override = Array.isArray(json.default ?? json) ? (json.default ?? json) : [];
} catch {
	// no override file – perfectly fine
}

/* ---------- Files on disk (static glob) ---------- */
const files = import.meta.glob('/src/assets/clients/*.{svg,png,webp,jpg,jpeg,avif,gif}', {
	eager: true,
	query: '?url',
	import: 'default',
}) as Record<string, string>;

// case-insensitive map so JSON “file” can be any casing
const filesLower = new Map(Object.keys(files).map((k) => [k.toLowerCase(), files[k]]));

/* ---------- Build final list ---------- */
let list: Logo[] = [];

if (explicit?.length) {
	list = explicit;
} else if (override.length) {
	// Map JSON → actual URLs from the glob; warn on missing files in dev
	list = override.flatMap((item) => {
		const key = `/src/assets/clients/${item.file}`;
		const url = files[key] ?? filesLower.get(key.toLowerCase());

		if (!url) {
			if (import.meta.env.DEV) console.warn(`[LogosRow] File not found: ${key}`);
			return [];
		}
		return [{ src: url, alt: item.alt, href: item.href }];
	});
	// If override references nothing valid, we’ll fall back below
}

if (!list.length) {
	// 3) Auto fallback: use everything in the folder, filename-sorted
	const entries = Object.entries(files).sort(([a], [b]) => a.localeCompare(b));
	list = entries.map(([full, url]) => {
		const filename = full.split('/').pop() || '';
		const base = filename.replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ');
		const alt = base ? base[0].toUpperCase() + base.slice(1) : 'Client logo';
		return { src: url, alt };
	});
}
---

{
	list.length === 0 ? null : (
		<div class={`logos-row ${klass}`}>
			{title && <p class="logos-title">{title}</p>}
			<ul class="logos" role="list">
				{list.map((l) => (
					<li>
						{l.href ? (
							<a href={l.href} target="_blank" rel="noopener">
								<img
									src={l.src}
									alt={l.alt || ''}
									loading="lazy"
									decoding="async"
								/>
							</a>
						) : (
							<img src={l.src} alt={l.alt || ''} loading="lazy" decoding="async" />
						)}
					</li>
				))}
			</ul>
		</div>
	)
}

<style>
	.logos-row {
		margin-block: var(--size--large);
	}
	.logos-title {
		color: var(--text-muted-colour);
		margin: 0 0 0.5rem 0;
	}
	.logos {
		--gap: clamp(0.75rem, 2vw, 1.25rem);
		display: flex;
		flex-wrap: wrap;
		gap: var(--gap);
		align-items: center;
		justify-content: center;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.logos img {
		display: block;
		height: 28px;
		width: auto;
		opacity: 0.85;
		transition: opacity 0.2s ease;
	}
	.logos a:hover img,
	.logos a:focus img {
		opacity: 1;
	}
</style>
