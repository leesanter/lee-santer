---
/**
 * 404.astro — Not Found page
 * ------------------------------------------------------------
 * - Uses Base layout (header/footer present)
 * - noindex: true
 * - Token-driven spacing; no inline styles
 * - Simple .btn anchors (swap to <Button> if you keep the component)
 */
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base
	title="Page not found"
	description="That page doesn’t exist."
	noindex={true}
	pageClass="error-page"
>
	<section class="section container container--large">
		<div class="error-hero">
			<div class="stack small center">
				<h1 class="h1">404 — Not found</h1>
				<p>Sorry, we couldn’t find that page. It may have moved or never existed.</p>
				<p class="btn-row">
					<a class="btn" href="/" rel="home">Go home</a>
					<a class="btn btn--outline" href="/contact">Contact us</a>
				</p>
			</div>
		</div>
	</section>
</Base>

<style lang="scss">
	/* ======================================================================
   404 page styles (scoped)
   - Centers content and uses your spacing tokens
====================================================================== */
	.error-page .error-hero {
		min-height: 60vh;
		display: grid;
		place-items: center;
		text-align: center;
		padding-block: var(--layout--section-y);
	}

	.error-page .btn-row {
		display: flex;
		gap: var(--size--small);
		flex-wrap: wrap;
		justify-content: center;
		margin-top: var(--size--small);
	}
</style>
