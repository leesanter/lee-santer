---
import Base from '../layouts/Base.astro';
import WorkList from 'src/components/organisms/WorkList.astro';
import InsightsList from 'src/components/organisms/InsightsList.astro';
import ClientSection from 'src/components/organisms/ClientSection.astro';

import { getWorkForHome, getCategorySlides, getLatestInsights } from '../lib/content';

export const prerender = true;

// Prefetch small data slices so sections can hide cleanly if empty
const homeEntries = await getWorkForHome(4); // newest → oldest (already sorted)
const slides = await getCategorySlides(); // service/category cards for home
const latestInsights = await getLatestInsights(4); // newest → oldest

const hasWork = homeEntries.length > 0;
const hasSlides = slides.length > 0;
const hasInsights = latestInsights.length > 0;
---

<Base
	title="Freelance Web & Brand Designer in Kent"
	description="Web design, branding & front-end development."
	seoAppendSiteName={false}
>
	<!-- Hero -->
	<section class="section">
		<div class="container container--large">
			<div class="stack large" style="text-align:center;">
				<h1>Driven brands, no matter the industry.</h1>
				<p>Strategy, design, and front-end builds that feel considered and fast.</p>
			</div>
		</div>
	</section>

	<!-- Featured Work -->
	{
		hasWork && (
			<section class="section" aria-labelledby="home-work">
				<div class="container container--large">
					<h2 id="home-work">Featured work</h2>
					<WorkList entries={homeEntries} lede="Selected work." />
					<p class="see-all">
						<a href="/work">See all work →</a>
					</p>
				</div>
			</section>
		)
	}

	<!-- Services -->
	{
		hasSlides && (
			<section class="section" aria-labelledby="home-services">
				<div class="container container--large">
					<h2 id="home-services">Services</h2>
					<ul class="cards" role="list">
						{slides.map((s) => (
							<li class="card">
								<h3 class="h4">{s.title}</h3>
								{s.summary && <p>{s.summary}</p>}
								<p>
									<a class="btn btn--outline" href={s.href}>
										Explore {s.title}
									</a>
								</p>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<!-- Latest Insights -->
	{
		hasInsights && (
			<section class="section" aria-labelledby="home-insights">
				<div class="container container--large">
					<h2 id="home-insights">Latest insights</h2>
					<InsightsList entries={latestInsights} />
					<p class="see-all">
						<a href="/insights">All insights →</a>
					</p>
				</div>
			</section>
		)
	}

	<ClientSection random />
</Base>
