---
import Base from '../layouts/Base.astro';
import WorkListing from 'src/components/organisms/WorkListing.astro';
import InsightsListing from 'src/components/organisms/InsightsListing.astro';
import ClientSection from 'src/components/organisms/ClientSection.astro';

import { getWorkForHome, getCategorySlides } from '../lib/content';

export const prerender = true;

const homeEntries = await getWorkForHome(4);
const slides = await getCategorySlides();
---

<Base
	title="Lee Santer"
	seoTitleTemplate="%s | Freelance Web & Brand Designer in Kent"
	description="Web design, branding & front-end development."
>
	<!-- Hero: keep or replace with your header/scroll test -->
	<section class="section">
		<div class="container container--large">
			<div class="stack large" style="text-align:center;">
				<h1>Driven brands, no matter the industry.</h1>
				<p>Strategy, design, and front-end builds that feel considered and fast.</p>
			</div>
		</div>
	</section>

	<!-- Featured Work -->
	<section class="section" aria-labelledby="home-work">
		<div class="container container--large">
			<h2 id="home-work">Featured work</h2>
			<WorkListing entries={homeEntries} lede="Selected work." />
			<p class="see-all"><a href="/work">See all work →</a></p>
		</div>
	</section>

	<section class="section">
		<div class="container container--large">
			<h2>Services</h2>
			<ul class="cards" role="list">
				{
					slides.map((s) => (
						<li class="card">
							<h2 class="h4">{s.title}</h2>
							{s.summary && <p>{s.summary}</p>}
							<p>
								<a class="btn btn--outline" href={s.href}>
									Explore {s.title}
								</a>
							</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Latest Insights -->
	<section class="section" aria-labelledby="home-insights">
		<div class="container container--large">
			<h2 id="home-insights">Latest insights</h2>

			<InsightsListing limit={4} />

			<p class="see-all"><a href="/insights">All insights →</a></p>
		</div>
	</section>

	<ClientSection random />
</Base>
