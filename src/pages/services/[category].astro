---
import Base from '../../layouts/Base.astro';
import { type CategorySlug, type CategoryKey } from '../../lib/categories';
import {
	getAllServiceCategoryOverviews,
	getCategoryBySlug,
	getSubServicesForCategory,
	getFeaturedWorkForCategory,
} from '../../lib/content';

export const prerender = true;

export async function getStaticPaths() {
	const cats = await getAllServiceCategoryOverviews();
	return cats.map((c) => ({
		params: { category: (c.data.category as string).toLowerCase() },
	}));
}

const { category } = Astro.params as { category: CategorySlug };
const entry = await getCategoryBySlug(category);
if (!entry) throw new Error(`Unknown service category: ${category}`);

const key = entry.data.category as CategoryKey;
const subs = await getSubServicesForCategory(key);
const featured = await getFeaturedWorkForCategory(key, entry.data.featuredWorkSlug);

// ---------- Canonical + Breadcrumb JSON-LD ----------
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Services',
			item: siteUrl ? new URL('/services', siteUrl).href : '/services',
		},
		{ '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical },
	],
};

// ---------- Optional FAQPage JSON-LD ----------
const faqLd = (entry.data as any).faqs?.length
	? {
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: (entry.data as any).faqs.map((f: { q: string; a: string }) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		}
	: null;

// MD/MDX body for the category doc
const { Content } = await entry.render();

const pageTitle = entry.data.seoTitle ?? `${entry.data.title} services`;
const pageDesc = entry.data.seoDescription ?? entry.data.summary ?? '';
---

<Base
	title={pageTitle}
	description={pageDesc}
	type="webpage"
	structuredData={faqLd ? [breadcrumbLd, faqLd] : breadcrumbLd}
>
	<section class="section">
		<div class="container container--large">
			<h1>{entry.data.title}</h1>
			{entry.data.summary && <p>{entry.data.summary}</p>}

			{
				entry.body && (
					<>
						<h2>Overview</h2>
						<Content />
					</>
				)
			}

			{
				subs.length > 0 && (
					<>
						<h2>Sub-services</h2>
						<ul>
							{subs.map((s) => {
								const anchor = s.data.anchor ?? s.slug.split('/').pop()!;
								return (
									<li id={anchor}>
										<h3>{s.data.title}</h3>
										{s.data.intro && <p>{s.data.intro}</p>}
										{s.data.outcomes.length > 0 && (
											<>
												<h4>Outcomes</h4>
												<ul>
													{s.data.outcomes.map((o) => (
														<li>{o}</li>
													))}
												</ul>
											</>
										)}
										{s.data.deliverables.length > 0 && (
											<>
												<h4>Deliverables</h4>
												<ul>
													{s.data.deliverables.map((d) => (
														<li>{d}</li>
													))}
												</ul>
											</>
										)}
									</li>
								);
							})}
						</ul>
					</>
				)
			}

			{
				featured && (
					<>
						<h2>Case study</h2>
						<p>
							<a href={`/work/${featured.slug}`}>{featured.data.title}</a>
						</p>
						<p>{featured.data.summary}</p>
					</>
				)
			}

			{
				entry.data.faqs.length > 0 && (
					<>
						<h2>FAQs</h2>
						<dl>
							{entry.data.faqs.map((f) => (
								<>
									<dt>{f.q}</dt>
									<dd>{f.a}</dd>
								</>
							))}
						</dl>
					</>
				)
			}
		</div>
	</section>
</Base>
