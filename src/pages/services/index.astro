---
import Base from '../../layouts/Base.astro';
import PageIntro from 'src/components/molecules/PageIntro.astro';
import Accordion from '../../components/molecules/Accordion.astro';
import WorkCard from '../../components/molecules/WorkCard.astro';
import ClientSection from 'src/components/organisms/ClientSection.astro';

import { getAllServiceCategoryOverviews, getSubServicesForCategory } from '../../lib/services';
import { getAllWork } from '../../lib/content';
import { keyToSlug, type CategoryKey } from '../../lib/categories';

export const prerender = true;

/* Local type for Accordion items */
type AccItem = {
	id: string;
	title: string;
	body?: string;
	expanded?: boolean;
	ctaHref?: string;
	ctaLabel?: string;
	ctaVariant?: 'primary' | 'outline' | 'text';
};

const cats = await getAllServiceCategoryOverviews();
const allWork = await getAllWork();

const sections = await Promise.all(
	cats.map(async (c, i) => {
		const key = c.data.category as CategoryKey;
		const slug = keyToSlug(key);

		const subs = await getSubServicesForCategory(key);
		const items: AccItem[] = subs.map((s) => {
			const id = (s.data as any).anchor ?? s.slug.split('/').pop()!;
			const lander = (s.data as any).landerSlug as string | undefined;
			const isDraft = !!s.data.draft;
			const href = lander && !isDraft ? `/services/${lander}` : undefined;

			return {
				id: String(id),
				title: String(s.data.title),
				body:
					(s.data as any).overviewShort ??
					(s.data as any).body ??
					(s.data as any).intro ??
					'',
				ctaHref: href,
				ctaLabel: 'Learn more',
				ctaVariant: 'text' as const,
			};
		});

		const fwSlug = (c.data as any).featuredWorkSlug as string | undefined;
		const fw = fwSlug ? allWork.find((w) => w.slug === fwSlug) : undefined;
		const caseCard = fw
			? {
					href: `/work/${fw.slug}`,
					title: fw.data.title,
					summary: fw.data.description,
					img: fw.data.featuredImage,
					alt: fw.data.featuredAlt,
					services: [],
					compact: true,
				}
			: null;

		const fallbackScheme: 'light' | 'dark' = i % 2 === 1 ? 'dark' : 'light';
		const scheme: 'light' | 'dark' =
			((c.data as any).bandScheme as 'light' | 'dark' | undefined) ?? fallbackScheme;

		return {
			num: String(i + 1).padStart(2, '0'),
			slug,
			title: c.data.title,
			subtitle: (c.data as any).servicesSubtitle ?? '',
			intro: (c.data as any).servicesOverview ?? (c.data as any).homeOverview ?? '',
			items,
			caseCard,
			scheme,
		};
	})
);

const pageTitle = 'Services';
const description = 'A helping hand through every step of your journey.';
---

<Base title={pageTitle} description={description}>
	<article class="entry entry--service">
		<PageIntro
			as="section"
			class="services-intro"
			container="large"
			align="left"
			subtitle="Services"
			title="A helping hand through every step of your journey."
			lede="My approach combines design and strategy tailored to your brand. I’m dedicated to helping you succeed, ensuring that your presence resonates with your audience from the initial concept through to ongoing growth."
		/>
		{
			sections.map((s) => (
				<section class="section services-section" id={s.slug} data-scheme={s.scheme}>
					<div class="container container--large">
						<div class="services-section__grid">
							{/* Row 1: number + title (full width) */}
							<div class="services-section__meta">
								<p class="services-section__num">({s.num})</p>
								<h2 class="h2 services-section__title">{s.title}</h2>
							</div>

							{/* Row 2, col 1: subtitle  */}
							<div class="services-section__aside">
								{s.subtitle && (
									<h3 class="services-section__subtitle">{s.subtitle}</h3>
								)}
							</div>

							{/* Row 2, col 2: accordion + intro*/}
							<div class="services-section__body">
								{s.intro && <p class="services-section__intro">{s.intro}</p>}
								<Accordion items={s.items} allowMultiple={false} openFirst />
							</div>
						</div>
					</div>

					{/* Keep case study inside the section so it inherits the scheme */}
					{s.caseCard && (
						<div class="container container--large">
							<div class="services-section__case">
								<ul
									class="work-grid work-grid--1"
									role="list"
									aria-label="Projects"
								>
									<li>
										<WorkCard {...s.caseCard} />
									</li>
								</ul>
							</div>
						</div>
					)}
				</section>
			))
		}
		<ClientSection random />
	</article>
</Base>

<style lang="scss">
	.services-section + .services-section {
		border-top: 1px solid var(--hairline-colour);
	}

	/* Base: stacked */
	.services-section__grid {
		display: grid;
		gap: var(--size--large);
	}

	/* Desktop: two-row layout
     Row 1: meta (spans both cols)
     Row 2: aside | body
  */
	@media (min-width: 980px) {
		.services-section__grid {
			grid-template-columns: 1.25fr 2fr;
			grid-template-areas:
				'meta  meta'
				'aside body';
			column-gap: var(--size--xlarge);
			row-gap: var(--size--large);
			align-items: start;
		}
		.services-section__meta {
			grid-area: meta;
		}
		.services-section__aside {
			grid-area: aside;
			max-width: 58ch;
		}
		.services-section__body {
			grid-area: body;
		}
	}

	.services-section__num {
		font-size: var(--font--larger);
		text-transform: uppercase;
		color: var(--text-muted-colour);
		margin: 0 0 0.25rem;
	}
	.services-section__title {
		margin: 0;
	}

	.services-section__subtitle {
		margin: 0 0 0.5rem 0;
		color: var(--heading-colour);
	}
	.services-section__intro {
		font-size: var(--font--larger);
		margin-bottom: var(--size--large);
		color: var(--text-colour);
	}

	.services-section__case {
		margin-top: var(--size--xlarge);
	}

	.work-grid {
		list-style: none;
		padding: 0;
		display: grid;
		gap: var(--size--large);
	}
	.work-grid--1 {
		grid-template-columns: 1fr;
	}
</style>
