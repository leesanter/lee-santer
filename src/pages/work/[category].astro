---
import Base from '../../layouts/Base.astro';
import WorkListing from '../../components/organisms/WorkListing.astro'; // (this is the FILTER nav)
import WorkCard from '../../components/molecules/WorkCard.astro';

import { fromSlug, CATEGORY_SLUGS, type CatSlug } from '../../lib/categories';
import { getAllWork, mapServiceKeysToLinks } from '../../lib/content';

export async function getStaticPaths() {
	return CATEGORY_SLUGS.map((slug) => ({ params: { category: slug } }));
}

const { category } = Astro.params as { category: CatSlug };
const proper = fromSlug(category); // "Design" | "Strategy" | "Development" | "Growth"

// Fetch & filter (multi-category)
const all = await getAllWork();
const entries = all.filter((w) => (w.data as any).serviceCategories?.includes(proper));

// Precompute card props (so we don't await inside the template loop)
const cards = await Promise.all(
	entries.map(async (entry) => ({
		entry,
		services: await mapServiceKeysToLinks(entry.data.services),
	}))
);
---

<Base title={`Work — ${proper}`} description={`Projects in ${proper}.`}>
	<h1>Work — {proper}</h1>

	<!-- Filter nav -->
	<WorkListing active={category} />

	<!-- Grid -->
	<ul class="work-grid" role="list">
		{
			cards.map(({ entry, services }) => (
				<li>
					<WorkCard entry={entry} services={services} />
				</li>
			))
		}
	</ul>
</Base>

<style>
	.work-grid {
		list-style: none;
		padding: 0;
		margin: var(--size--large) 0 0 0;
		display: grid;
		gap: var(--size--large);
	}
</style>
