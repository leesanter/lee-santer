---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import WorkListing from '../../components/organisms/WorkListing.astro';

export function getStaticPaths() {
	return [
		{ params: { category: 'strategy' } },
		{ params: { category: 'design' } },
		{ params: { category: 'development' } },
		{ params: { category: 'growth' } },
	];
}

const CATS = ['strategy', 'design', 'development', 'growth'] as const;
type Cat = (typeof CATS)[number];

const raw = (Astro.params.category as string) || 'strategy';
const active: Cat = (CATS as readonly string[]).includes(raw) ? (raw as Cat) : 'strategy';

const all = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
	(a, b) => new Date(b.data.completedDate).getTime() - new Date(a.data.completedDate).getTime()
);

const entries = all.filter((e) => e.data.workFilterCategory.toLowerCase() === active);

const title = `Work — ${active.charAt(0).toUpperCase() + active.slice(1)} — Lee Santer`;
const description = `Case studies focused on ${active}.`;
---

<Base {title} {description}>
	<header data-bg-color="light" class="section container container--large">
		<div class="section-layout">
			<div class="content-layout">
				<div class="content-column span-10">
					<div class="stack medium">
						<div class="stack xsmall">
							<!-- <p class="text-larger">Case Studies</p> -->
							<h1>Thoughtful design for standout digital experiences</h1>
						</div>
						<p class="text-larger">
							Get inspired and see how I can bring your digital vision to life.
						</p>
					</div>
				</div>
			</div>
		</div>
	</header>

	<WorkListing entries={entries} active={active} />
</Base>
