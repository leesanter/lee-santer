---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/organisms/WorkList.astro';
import { CATEGORY_SLUGS, type CategorySlug } from '../../lib/categories';
import type { GetStaticPaths } from 'astro';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async () => {
	return CATEGORY_SLUGS.map((slug) => ({ params: { category: slug } }));
};

const { category } = Astro.params as { category: CategorySlug };
const proper = (s: string) => s.slice(0, 1).toUpperCase() + s.slice(1);
---

<Base title={`Work — ${proper(category)}`} description={`Projects in ${proper(category)}.`}>
	<h1>Work — {proper(category)}</h1>
	<WorkList
		category={category}
		showFilter
		active={category}
		lede={`Projects in ${proper(category)}.`}
	/>
</Base>
