---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import WorkListing from '../../components/organisms/WorkListing.astro';

const entries = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.completedDate.getTime() - a.data.completedDate.getTime()
);

const title = 'Work — Lee Santer';
const description = 'Selected case studies across strategy, design, development and growth.';
const pathFor = (cat: 'all' | 'strategy' | 'design' | 'development' | 'growth') =>
	cat === 'all' ? '/work' : `/work/${cat}`;
---

<Base {title} {description}>
	<header data-bg-color="light" class="section container container--large">
		<div class="section-layout">
			<div class="content-layout">
				<div class="content-column span-10">
					<div class="stack medium">
						<div class="stack xsmall">
							<!-- <p class="text-larger">Case Studies</p> -->
							<h1>Thoughtful design for standout digital experiences</h1>
						</div>
						<p class="text-larger">
							Get inspired and see how I can bring your digital vision to life.
						</p>
					</div>
				</div>
			</div>
		</div>
	</header>

	<WorkListing entries={entries} active="all" />
</Base>
