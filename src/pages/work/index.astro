---
import Base from '../../layouts/Base.astro';
import WorkList from '../../components/organisms/WorkList.astro';
import { getAllWork } from '../../lib/content';

export const prerender = true;

const entries = await getAllWork(); // newest → oldest
---

<Base title="Work" description="Selected projects.">
	<h1>Work</h1>
	<WorkList entries={entries} showFilter active="all" lede="Filter by focus area." />
</Base>
