---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry } from 'astro:content';
import { Image as AstroImage } from 'astro:assets';
import WorkCard from '../../components/molecules/WorkCard.astro';
import { mapDisplayServicesToLinks, pickNextCaseStudy } from '../../lib/caseStudies';
import { mdToHtml } from '../../lib/md';

export async function getStaticPaths() {
	const all = await getCollection('case-studies');
	return all.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params as { slug: string };
const entry = await getEntry('case-studies', slug);
if (!entry) throw new Error(`Case study not found: ${slug}`);

const {
	title,
	summary,
	hero, // ImageMetadata (from image())
	heroAlt = '',
	displayServices = [],
	completedDate,
	siteUrl, // canonical
	sections = [],
	galleries = [],
} = entry.data;

const services = mapDisplayServicesToLinks(displayServices);
const formattedDate = completedDate
	? new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(
			new Date(completedDate)
		)
	: null;

const all = (await getCollection('case-studies', ({ data }) => !data.draft)).sort(
	(a, b) => new Date(b.data.completedDate).getTime() - new Date(a.data.completedDate).getTime()
);
const nextEntry = pickNextCaseStudy(all, entry);

const pageTitle = `${title} — Case Study — Lee Santer`;
const description = summary ?? `Case study: ${title}.`;
---

<Base title={pageTitle} description={description}>
	<!-- HERO -->
	<header class="section is-flush case-hero">
		<figure class="case-hero__media" data-parallax>
			<AstroImage
				src={hero}
				alt={heroAlt}
				widths={[960, 1280, 1600, 1920]}
				sizes="100vw"
				loading="eager"
				decoding="async"
				class="case-hero__img"
			/>
			<div class="case-hero__overlay text-override-light">
				<h1 class="case-hero__title">{title}</h1>
			</div>
			<div class="image-revealer" aria-hidden="true" data-reveal></div>
		</figure>
	</header>

	<!-- META + OVERVIEW -->
	<section class="section">
		<div class="container container--large">
			<div class="section-layout">
				<div class="content-layout">
					<!-- Left: meta -->
					<div class="content-column span-4">
						<div class="stack medium">
							{
								services.length > 0 && (
									<div class="stack xsmall">
										<p class="text-larger text-muted">What I did</p>
										<div class="stack tiny">
											{services.map((s) =>
												s.href ? (
													<a href={s.href} class="text-larger">
														{s.label}
													</a>
												) : (
													<span class="text-larger">{s.label}</span>
												)
											)}
										</div>
									</div>
								)
							}
							{
								formattedDate && (
									<div class="stack xsmall">
										<p class="text-larger text-muted">Completed</p>
										<p class="text-larger">{formattedDate}</p>
									</div>
								)
							}
							{
								siteUrl && (
									<a
										class="text-larger text-muted"
										href={siteUrl}
										target="_blank"
										rel="noopener noreferrer"
									>
										Visit Site ↗
									</a>
								)
							}
						</div>
					</div>

					<!-- Right: Project Overview -->
					<div class="content-column span-8">
						{
							sections[0] && (
								<div class="stack xsmall prose">
									<h2 class="h3">{sections[0].title}</h2>
									<div set:html={mdToHtml(sections[0].prose)} />
								</div>
							)
						}
					</div>
				</div>

				<!-- Image after overview -->
				{
					galleries[0]?.images?.[0] && (
						<div class="image-wrap case-image">
							<AstroImage
								src={galleries[0].images[0].src}
								alt={galleries[0].images[0].alt ?? ''}
								widths={[960, 1280, 1600]}
								sizes="(min-width: 1100px) 1100px, 92vw"
								loading="lazy"
								decoding="async"
								class="case-image__img"
							/>
							<div class="image-revealer" aria-hidden="true" />
						</div>
					)
				}

				<!-- Remaining sections interleaved with images -->
				{
					sections.slice(1).map((s, idx) => (
						<>
							<div class="content-layout">
								<div class="content-column span-8">
									<div class="stack xsmall prose">
										<h3>{s.title}</h3>
										<div set:html={mdToHtml(s.prose)} />
									</div>
								</div>
							</div>

							{galleries[idx + 1]?.images?.[0] && (
								<div class="image-wrap case-image">
									<AstroImage
										src={galleries[idx + 1].images[0].src}
										alt={galleries[idx + 1].images[0].alt ?? ''}
										widths={[960, 1280, 1600]}
										sizes="(min-width: 1100px) 1100px, 92vw"
										loading="lazy"
										decoding="async"
										class="case-image__img"
									/>
									<div class="image-revealer" aria-hidden="true" />
								</div>
							)}
						</>
					))
				}
			</div>
		</div>
	</section>

	{
		nextEntry && (
			<section class="section">
				<div class="container container--large">
					<div class="section-layout">
						<div class="stack small">
							<p class="text-muted">Next case study</p>
							<ul class="work-grid" role="list">
								<li>
									<WorkCard
										entry={nextEntry}
										services={mapDisplayServicesToLinks(
											nextEntry.data.displayServices
										)}
									/>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</section>
		)
	}
</Base>

<style lang="scss">
	.case-hero {
		position: relative;
	}
	.case-hero__media {
		position: relative;
		width: 100%;
		aspect-ratio: 16/9;
		overflow: hidden;
	}
	.case-hero__img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 120%;
		object-fit: cover;
		object-position: 50% 50%;
	}
	.case-hero__overlay {
		position: absolute;
		left: var(--size--xlarge);
		right: var(--size--xlarge);
		bottom: var(--size--xlarge);
		pointer-events: none;
	}
	.case-hero__title {
		margin: 0;
	}

	.image-wrap.case-image {
		position: relative;
		width: 100%;
		aspect-ratio: 3/2;
		overflow: hidden;
	}
	.case-image__img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.image-revealer {
		display: none;
		position: absolute;
		inset: 0;
		width: 110%;
		height: 100%;
		background: #fff;
		z-index: 2;
	}
	.text-muted {
		color: var(--text-muted-colour);
	}
</style>
