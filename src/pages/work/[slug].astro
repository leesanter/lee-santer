---
// src/pages/work/[slug].astro
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getAllWork, nextPrev, mapServiceKeysToLinks, byDateDesc } from '../../lib/content';
import { getCollection } from 'astro:content';
import { md } from '../../lib/md';
import ClientSection from 'src/components/organisms/ClientSection.astro';
import { formatDate } from 'src/lib/format';

export async function getStaticPaths() {
	const entries = await getCollection('work', (w) => !w.data.draft);
	entries.sort(byDateDesc);
	return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const all = await getAllWork();
const entry = all.find((e) => e.slug === slug)!;
const { next, prev } = nextPrev(all, slug!);
const serviceLinks = await mapServiceKeysToLinks(entry.data.services);

/* ---------- Breadcrumb JSON-LD ---------- */
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Work',
			item: siteUrl ? new URL('/work', siteUrl).href : '/work',
		},
		{ '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical },
	],
};

/* ---------- Overview + content stream ---------- */
type Block =
	| { kind: 'image'; src: ImageMetadata; alt: string }
	| { kind: 'section'; title: string; html: string };

const sections = entry.data.sections ?? [];
const gallery = (entry.data.gallery ?? []) as { src: ImageMetadata; alt?: string }[];

// Overview lives beside meta; fallback to summary if not provided.
const overviewTitle = entry.data.overviewTitle ?? 'Project Overview';
const overviewHTML = await md(entry.data.overview ?? entry.data.summary);

// If you kept an early section called “Project Overview”, hide it when top-level overview exists.
const renderSections = entry.data.overview
	? sections.filter((s) => s.title.trim() !== overviewTitle.trim())
	: sections;

// Placement: 'interleave' | 'before' | 'after'
const placement = entry.data.galleryPlacement ?? 'interleave';

// Precompute blocks
const sectionBlocks: Block[] = await Promise.all(
	renderSections.map(async (s) => ({
		kind: 'section' as const,
		title: s.title,
		html: await md(s.body),
	}))
);

const imageBlocks: Block[] = gallery.map((g) => ({
	kind: 'image' as const,
	src: g.src,
	alt: g.alt || '',
}));

let blocks: Block[] = [];
if (placement === 'before') {
	blocks = [...imageBlocks, ...sectionBlocks];
} else if (placement === 'after') {
	blocks = [...sectionBlocks, ...imageBlocks];
} else {
	// interleave (image0 → section0 → image1 → section1 → …)
	let gi = 0;
	if (imageBlocks[gi]) blocks.push(imageBlocks[gi++]);
	for (const sb of sectionBlocks) {
		blocks.push(sb);
		if (imageBlocks[gi]) blocks.push(imageBlocks[gi++]);
	}
}

const completed = formatDate(entry.data.completedDate, 'MMM yyyy');
---

<Base
	title={entry.data.title}
	titleTemplate="%s | Case Study"
	description={entry.data.summary}
	image={entry.data.ogImage ?? entry.data.featuredImage}
	type="creativework"
	publishedTime={entry.data.completedDate}
	structuredData={breadcrumbLd}
>
	<article>
		<!-- HERO -->
		<figure class="hero">
			<Image
				src={entry.data.featuredImage}
				alt={entry.data.featuredAlt}
				widths={[1200, 1600, 2000, 2400]}
				sizes="100vw"
				loading="eager"
				decoding="async"
			/>
			<figcaption class="sr-only">{entry.data.title}</figcaption>
		</figure>

		<!-- META + OVERVIEW -->
		<section class="section">
			<div class="container container--large two-col">
				<aside class="meta">
					<h2 class="h6">What I did</h2>
					<ul class="chips" role="list">
						{
							serviceLinks.map((s) => (
								<li>
									{s.href ? (
										<a href={s.href}>{s.label}</a>
									) : (
										<span>{s.label}</span>
									)}
								</li>
							))
						}
					</ul>

					<dl class="kv">
						<div><dt>Completed</dt><dd>{completed}</dd></div>
						{
							entry.data.siteUrl && (
								<div>
									<dt>Visit</dt>
									<dd>
										<a href={entry.data.siteUrl} rel="noopener" target="_blank">
											Project site
										</a>
									</dd>
								</div>
							)
						}
					</dl>
				</aside>

				<article class="overview">
					<h1 class="h2">{entry.data.title}</h1>
					<h2 class="h3">{overviewTitle}</h2>
					<div class="prose" set:html={overviewHTML} />
				</article>
			</div>
		</section>

		<!-- STREAM -->
		<section class="section">
			<div class="container container--large stack">
				{
					blocks.map((b) =>
						b.kind === 'image' ? (
							<figure class="case-image">
								<Image
									src={b.src}
									alt={b.alt}
									widths={[768, 1280, 1600]}
									sizes="100vw"
									loading="lazy"
									decoding="async"
								/>
							</figure>
						) : (
							<article class="case-section stack tiny">
								<h3 class="h4">{b.title}</h3>
								<div class="prose" set:html={b.html} />
							</article>
						)
					)
				}
			</div>
		</section>

		<!-- TESTIMONIAL (this case only; no random) -->
		<ClientSection workEntry={entry} showWorkLink={false} />
	</article>

	<!-- NEXT / PREV -->
	<nav aria-label="Case navigation" class="section">
		<div class="container container--large nextprev">
			{
				prev && (
					<a class="btn btn--outline" href={`/work/${prev.slug}`}>
						← {prev.data.title}
					</a>
				)
			}
			{
				next && (
					<a class="btn btn--outline" href={`/work/${next.slug}`}>
						{next.data.title} →
					</a>
				)
			}
		</div>
	</nav>
</Base>

<style>
	.hero img {
		width: 100%;
		height: auto;
		display: block;
	}
	.two-col {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: var(--size--xlarge);
		align-items: start;
	}
	.chips {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.kv {
		display: grid;
		gap: 0.25rem;
	}
	.case-image img {
		width: 100%;
		height: auto;
		display: block;
	}
	.case-section {
		max-width: 72ch;
	}
	.nextprev {
		display: flex;
		justify-content: space-between;
		gap: var(--size--small);
	}
	@media (max-width: 900px) {
		.two-col {
			grid-template-columns: 1fr;
		}
	}
</style>
