---
import Base from '../../layouts/Base.astro';
import { getAllWork, nextPrev, mapServiceKeysToLinks } from '../../lib/content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', (w) => !w.data.draft);
  return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const all = await getAllWork();
const entry = all.find((e) => e.slug === slug)!;
const { next, prev } = nextPrev(all, slug!);
const serviceLinks = await mapServiceKeysToLinks(entry.data.services);

// Breadcrumb JSON-LD
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Work", "item": siteUrl ? new URL('/work', siteUrl).href : '/work' },
    { "@type": "ListItem", "position": 2, "name": entry.data.title, "item": canonical }
  ]
};
---

<Base
  title={entry.data.title}
  seoTitleTemplate="%s | Case Study"
  description={entry.data.summary}
  seoImage={entry.data.ogImage ?? entry.data.featuredImage}
  type="creativework"
  publishedTime={entry.data.completedDate}
  structuredData={breadcrumbLd}
>
  <article>
	<img src={entry.data.featuredImage.src} alt={entry.data.featuredAlt} />
	<h1>{entry.data.title}</h1>
	{entry.data.siteUrl && <p><a href={entry.data.siteUrl} rel="noopener noreferrer" target="_blank">View site</a></p>}

	<!-- Service chips (auto deep-links) -->
	<p>
	  {serviceLinks.map(s => s.href ? <a href={s.href}>{s.label}</a> : <span>{s.label}</span>)}
	</p>

	<!-- Sections -->
	{entry.data.sections.map(s => (
	  <section id={s.title.toLowerCase().replace(/\s+/g,'-')}>
		<h2>{s.title}</h2>
		<!-- Expect HTML in s.body -->
		<div set:html={s.body} />
		{s.image && <img src={s.image.src} alt={s.imageAlt || ''} />}
	  </section>
	))}

	{entry.data.testimonial && (
	  <aside class="testimonial">
		<blockquote>
		  <p>“{entry.data.testimonial.quote}”</p>
		</blockquote>
		<footer>
		  <strong>{entry.data.testimonial.personName}</strong>
		  {entry.data.testimonial.role && `, ${entry.data.testimonial.role}`}
		  {entry.data.testimonial.company && `, ${entry.data.testimonial.company}`}
		</footer>
	  </aside>
	)}

  </article>

  <nav aria-label="Post navigation">
	{prev && <a href={`/work/${prev.slug}`}>← {prev.data.title}</a>}
	{next && <a href={`/work/${next.slug}`}>{next.data.title} →</a>}
  </nav>
</Base>
