---
import Base from '../../layouts/Base.astro';
import { getAllWork, nextPrev, mapServiceKeysToLinks } from '../../lib/content';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('work', w => !w.data.draft);
  return entries.map(e => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;
const all = await getAllWork();
const entry = all.find(e => e.slug === slug)!;
const { next, prev } = nextPrev(all, slug!);
const serviceLinks = await mapServiceKeysToLinks(entry.data.services);
---

<Base>
  <article>
    <img src={entry.data.featuredImage.src} alt={entry.data.featuredAlt} />
    <h1>{entry.data.title}</h1>
    {entry.data.siteUrl && <p><a href={entry.data.siteUrl} rel="noopener noreferrer" target="_blank">View site</a></p>}

    <!-- Service chips (auto deep-links) -->
    <p>
      {serviceLinks.map(s => s.href ? <a href={s.href}>{s.label}</a> : <span>{s.label}</span>)}
    </p>

    <!-- Sections -->
    {entry.data.sections.map(s => (
      <section id={s.title.toLowerCase().replace(/\s+/g,'-')}>
        <h2>{s.title}</h2>
        <!-- Expect HTML in s.body -->
        <div set:html={s.body} />
        {s.image && <img src={s.image.src} alt={s.imageAlt || ''} />}
      </section>
    ))}

  </article>

  <nav aria-label="Post navigation">
    {prev && <a href={`/work/${prev.slug}`}>← {prev.data.title}</a>}
    {next && <a href={`/work/${next.slug}`}>{next.data.title} →</a>}
  </nav>
</Base>
