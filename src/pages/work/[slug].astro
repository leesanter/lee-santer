---
// src/pages/work/[slug].astro
import Base from '../../layouts/Base.astro';
import type { ImageMetadata } from 'astro';
import { getAllWork, nextPrev, mapServiceKeysToLinks } from '../../lib/content';
import { md } from '../../lib/md';
import RevealImage from '../../components/molecules/RevealImage.astro';
import WorkCard from '../../components/molecules/WorkCard.astro';
import ClientSection from 'src/components/organisms/ClientSection.astro';
import { getTestimonialsForWork } from '../../lib/content'; // re-export from lib/work
import { formatDate } from 'src/lib/format';

export async function getStaticPaths() {
	const entries = await getAllWork(); // already sorted newest→oldest
	return entries.map((e) => ({ params: { slug: e.slug } }));
}

const { slug } = Astro.params;

// Single read: fetch all, then derive entry + next/prev from the same list
const all = await getAllWork();
const entry = all.find((e) => e.slug === slug)!;
if (!entry) throw new Error(`Work entry not found for slug: ${slug}`);

const { next } = nextPrev(all, slug!);
const serviceLinks = await mapServiceKeysToLinks(entry.data.services);

const nextServices = next
	? (await mapServiceKeysToLinks(next.data.services)).map(({ label, href }) => ({
			label,
			href: href ?? null,
		}))
	: [];

/* ---------- Canonical + JSON-LD ---------- */
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Work',
			item: siteUrl ? new URL('/work', siteUrl).href : '/work',
		},
		{ '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical },
	],
};

const ogUrlFallback = `/og/work/${entry.slug}.png`;
const caseLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: entry.data.title,
	url: canonical,
	datePublished:
		(entry.data.completedDate as Date).toISOString?.() ??
		new Date(entry.data.completedDate).toISOString(),
	image: (entry.data.ogImage ?? entry.data.featuredImage)?.src ?? ogUrlFallback,
};

/* ---------- Overview + content stream ---------- */
type Block =
	| { kind: 'image'; src: ImageMetadata; alt: string }
	| { kind: 'section'; title: string; html: string };

const sections = entry.data.sections ?? [];
const gallery = (entry.data.gallery ?? []) as { src: ImageMetadata; alt?: string }[];

// Overview lives beside meta; fallback to summary if not provided.
const overviewTitle = entry.data.overviewTitle ?? 'Project Overview';
const overviewHTML = await md(entry.data.overview ?? entry.data.summary);

// If you kept an early section called “Project Overview”, hide it when top-level overview exists.
const renderSections = entry.data.overview
	? sections.filter((s) => s.title.trim() !== overviewTitle.trim())
	: sections;

// Placement: 'interleave' | 'before' | 'after'
const placement = entry.data.galleryPlacement ?? 'interleave';

// Precompute blocks
const sectionBlocks: Block[] = await Promise.all(
	renderSections.map(async (s) => ({
		kind: 'section' as const,
		title: s.title,
		html: await md(s.body),
	}))
);

const imageBlocks: Block[] = gallery.map((g) => ({
	kind: 'image' as const,
	src: g.src,
	alt: g.alt || '',
}));

let blocks: Block[] = [];
if (placement === 'before') {
	blocks = [...imageBlocks, ...sectionBlocks];
} else if (placement === 'after') {
	blocks = [...sectionBlocks, ...imageBlocks];
} else {
	// interleave (image0 → section0 → image1 → section1 → …)
	let gi = 0;
	if (imageBlocks[gi]) blocks.push(imageBlocks[gi++]);
	for (const sb of sectionBlocks) {
		blocks.push(sb);
		if (imageBlocks[gi]) blocks.push(imageBlocks[gi++]);
	}
}

// Determine which image should get the "main" class.
// Prefer filename-based (_main) detection; fall back to the first image in the stream.
const isNamedMain = (blk: Block) =>
	blk.kind === 'image' && /(^|[_-])main(?:[.@_-]|$)/i.test(blk.src.src);

const namedMainIndex = blocks.findIndex(isNamedMain);
const firstImageIndex = blocks.findIndex((blk) => blk.kind === 'image');
const mainImageIndex = namedMainIndex !== -1 ? namedMainIndex : firstImageIndex;

const completed = formatDate(entry.data.completedDate, 'MMM yyyy');

// OG image for meta tags: prefer explicit → featured → generated fallback
const ogImageForMeta = entry.data.ogImage ?? entry.data.featuredImage ?? ogUrlFallback;
---

<Base
	title={entry.data.title}
	titleTemplate="%s | Case Study"
	description={entry.data.summary}
	image={ogImageForMeta}
	type="creativework"
	publishedTime={entry.data.completedDate}
	structuredData={[breadcrumbLd, caseLd]}
	headerOverlay="dark"
>
	<article class="entry entry--work">
		<header class="entry__header">
			<figure class="entry__hero">
				<RevealImage
					image={entry.data.featuredImage}
					alt={entry.data.featuredAlt}
					widths={[1200, 1600, 2000, 2400]}
					sizes="100vw"
					loading="eager"
					decoding="async"
					parallax
				/>
			</figure>
			<h1 class="entry__title">{entry.data.title}</h1>
		</header>

		<section class="section" data-bg-color="light">
			<div class="container container--medium">
				<div class="entry__wrapper">
					<div class="entry__intro">
						<aside class="entry__meta">
							<div class="entry__services">
								<h2 id="services-heading" class="h5">What I did</h2>
								<ul
									class="entry__services-list"
									role="list"
									aria-labelledby="services-heading"
								>
									{
										serviceLinks.map((s) => (
											<li>
												{s.href ? (
													<a href={s.href}>{s.label}</a>
												) : (
													<span>{s.label}</span>
												)}
											</li>
										))
									}
								</ul>
							</div>

							<div class="entry__date">
								<h2 class="h5">Completed</h2>
								<p>
									<time
										datetime={new Date(entry.data.completedDate).toISOString()}
										>{completed}</time
									>
								</p>
							</div>
							<div class="entry__site">
								{
									entry.data.siteUrl && (
										<a href={entry.data.siteUrl} rel="noopener" target="_blank">
											Visit Site
										</a>
									)
								}
							</div>
						</aside>
						<section class="entry__overview">
							<div class="stack xsmall">
								<h2 class="h3">{overviewTitle}</h2>
								<div class="prose" set:html={overviewHTML} />
							</div>
						</section>
					</div>

					<div class="entry__body">
						{
							blocks.map((b, i) =>
								b.kind === 'image' ? (
									<RevealImage
										class={`entry__image${i === mainImageIndex ? ' entry__image--main' : ''}`}
										image={b.src}
										alt={b.alt}
										widths={[768, 1280, 1600]}
										sizes="100vw"
									/>
								) : (
									<section class="entry__section">
										<div class="stack xsmall">
											<h3 class="h4">{b.title}</h3>
											<div class="prose" set:html={b.html} />
										</div>
									</section>
								)
							)
						}
					</div>
				</div>
			</div>
		</section>
	</article>

	<ClientSection workEntry={entry} showWorkLink={false} />

	<footer class="section">
		<div class="container container--large">
			<div class="entry__nav">
				<h2 class="h4">Next project</h2>
				<nav aria-label="Case navigation" class="nextprev nextprev--cards">
					{
						next && (
							<WorkCard
								compact
								class="nextprev__card"
								href={`/work/${next.slug}`}
								title={next.data.title}
								img={next.data.featuredImage}
								alt={next.data.featuredAlt ?? next.data.title}
								services={nextServices}
							/>
						)
					}
				</nav>
			</div>
		</div>
	</footer>

	<style lang="scss">
		.entry--work {
			.entry__header {
				position: relative;
				max-height: 100vh;
				overflow: hidden;
				.entry__title {
					position: absolute;
					left: var(--size--large);
					right: auto;
					bottom: var(--size--large);
					color: white;
					font-size: var(--font--hero);
				}
			}

			.entry__wrapper,
			.entry__body {
				display: grid;
				grid-column: 1;
				gap: var(--size--xlarge);
			}

			.entry__intro {
				display: flex;
				flex-direction: row;
				justify-content: space-between;
				align-items: flex-start;

				.entry__meta {
					display: flex;
					flex-direction: column;
					gap: var(--size--medium);

					.entry__services,
					.entry__date,
					.entry__site {
						display: flex;
						flex-direction: column;
						gap: var(--size--tiny);
					}

					.entry__services {
						.entry__services-list {
							list-style: none;
							padding: 0;
							margin: 0;
						}
					}
				}

				.entry__overview {
					flex-basis: 65%;
				}
			}

			.entry__overview,
			.entry__section {
				font-size: var(--font--large);
			}
		}

		.entry__image--main {
			padding: var(--size--large);
			background-color: var(--palette--neutral-900);
			aspect-ratio: auto;
		}

		.entry__nav {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			align-items: flex-start;

			div {
			}
			.nextprev--cards {
				flex-basis: 65%;
			}
		}
	</style>
</Base>
