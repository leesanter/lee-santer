---
/**
 * 500.astro — Not Found page
 * ------------------------------------------------------------
 * - Uses Base layout (header/footer present)
 * - noindex: true
 * - Token-driven spacing; no inline styles
 * - Simple .btn anchors (swap to <Button> if you keep the component)
 */
import Base from '../layouts/Base.astro';

export const prerender = true;

const title = 'Something went wrong';
const description = 'TAn unexpected error occurred.';
---

<Base {title} {description} noindex={true} pageClass="error-page">
	<section class="container container--large">
		<div class="error-hero">
			<div class="stack small center">
				<h1 class="h1">4500 — Server error</h1>
				<p>Please try again or <a class="link-style" href="/contact">contact us</a>.</p>
				<p class="btn-row">
					<a class="btn" href="/">Go home</a>
				</p>
			</div>
		</div>
	</section>
</Base>

<style lang="scss">
	/* ======================================================================
   404 page styles (scoped)
   - Centers content and uses your spacing tokens
====================================================================== */
	.error-page .error-hero {
		min-height: 60vh;
		display: grid;
		place-items: center;
		text-align: center;
		padding-block: var(--layout--section-y);
	}

	.error-page .btn-row {
		display: flex;
		gap: var(--size--small);
		flex-wrap: wrap;
		justify-content: center;
		margin-top: var(--size--small);
	}
</style>
