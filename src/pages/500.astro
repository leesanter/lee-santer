---
/**
 * 500.astro — Server error
 * - Uses Base layout (header/footer present)
 * - noindex: true
 * - Token-driven spacing; no inline styles
 * - Simple .btn anchors (swap to <Button> if you keep the component)
 */
import Base from '../layouts/Base.astro';

export const prerender = true;
---

<Base
	title="Something went wrong"
	description="An unexpected error occurred."
	noindex={true}
	pageClass="error-page"
>
	<section class="section container container--large">
		<div class="error-hero">
			<div class="stack small center">
				<h1 class="h1">500 — Server error</h1>
				<p>Please try again or <a class="link-style" href="/contact">contact us</a>.</p>
				<p class="btn-row">
					<a class="btn" href="/">Go home</a>
				</p>
			</div>
		</div>
	</section>
</Base>

<style lang="scss">
	.error-page .error-hero {
		min-height: 60vh;
		display: grid;
		place-items: center;
		text-align: center;
		padding-block: var(--layout--section-y);
	}
	.error-page .btn-row {
		display: flex;
		gap: var(--size--small);
		flex-wrap: wrap;
		justify-content: center;
		margin-top: var(--size--small);
	}
</style>
