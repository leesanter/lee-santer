---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import InsightCard from '../../components/molecules/InsightCard.astro';

const entries = (await getCollection('insights', ({ data }) => !data.draft)).sort(
	(a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const pageTitle = 'Insights — Lee Santer';
const pageDesc = 'Articles and notes on strategy, design, development and growth.';
---

<Base>
	<header class="section container stack">
		<h1 class="h1">Insights</h1>
		<p class="lede">Short, useful pieces on clarity, interfaces, and shipping fast.</p>
		<p><a href="/insights.xml" rel="alternate" type="application/rss+xml">RSS feed</a></p>
	</header>

	{
		entries.length === 0 ? (
			<section class="section container">
				<p>Insights coming soon.</p>
			</section>
		) : (
			<section class="section container">
				<div class="insights-grid">
					{entries.map((entry) => (
						<InsightCard entry={entry} />
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	.section {
		padding-block: var(--section-y, 4rem);
	}
	.container {
		width: min(1100px, 92vw);
		margin-inline: auto;
	}
	.stack > * + * {
		margin-top: 0.75rem;
	}
	.insights-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1rem;
	}
</style>
