---
import Base from '../../layouts/Base.astro';
import { Image } from 'astro:assets';
import { getAllPosts, nextPrev } from '../../lib/content';

export async function getStaticPaths() {
	// Use our helper; it's already filtering drafts and gives the same slugs
	const posts = await getAllPosts();
	return posts.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const all = await getAllPosts();
const entry = all.find((e) => e.slug === slug)!;
const { next, prev } = nextPrev(all, slug!);

// Canonical + Breadcrumb JSON-LD
const siteUrl = import.meta.env.PUBLIC_SITE_URL || '';
const canonical = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;

const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Insights',
			item: siteUrl ? new URL('/insights', siteUrl).href : '/insights',
		},
		{ '@type': 'ListItem', position: 2, name: entry.data.title, item: canonical },
	],
};

// OG fallback for meta + JSON-LD
const ogUrlFallback = `/og/insights/${entry.slug}.png`;
const ogSrcCandidate = (entry.data.ogImage ?? entry.data.featuredImage)?.src ?? ogUrlFallback;
const imageAbs = siteUrl ? new URL(ogSrcCandidate, siteUrl).href : ogSrcCandidate;

// Article JSON-LD (BlogPosting ⊂ Article is fine)
const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: entry.data.title,
	datePublished:
		(entry.data.date as Date).toISOString?.() ?? new Date(entry.data.date).toISOString(),
	author: { '@type': 'Person', name: entry.data.author ?? 'Lee Santer' },
	mainEntityOfPage: canonical,
	image: imageAbs,
};

// Meta image (object or string)
const seoImageForMeta = entry.data.ogImage ?? entry.data.featuredImage ?? ogUrlFallback;
---

<Base
	title={entry.data.title}
	seoTitleTemplate="%s | Insights"
	description={entry.data.summary}
	seoImage={seoImageForMeta}
	type="article"
	publishedTime={entry.data.date}
	structuredData={[breadcrumbLd, articleLd]}
>
	<article>
		{
			entry.data.featuredImage && (
				<Image
					src={entry.data.featuredImage}
					alt={entry.data.featuredAlt || ''}
					widths={[1200, 1600, 2000]}
					sizes="100vw"
					loading="eager"
					decoding="async"
				/>
			)
		}
		<h1>{entry.data.title}</h1>
		<p>{entry.data.summary}</p>
		<slot />
		{/* MDX body renders automatically */}
	</article>

	<nav aria-label="Post navigation">
		{
			prev && (
				<a href={`/insights/${prev.slug}`} rel="prev">
					← {prev.data.title}
				</a>
			)
		}
		{
			next && (
				<a href={`/insights/${next.slug}`} rel="next">
					{next.data.title} →
				</a>
			)
		}
	</nav>
</Base>
