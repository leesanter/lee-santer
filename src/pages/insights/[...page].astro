---
import Base from '../../layouts/Base.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { POSTS_PER_PAGE } from '../../lib/constants';
import type { GetStaticPaths } from 'astro';
import InsightsList from '../../components/organisms/InsightsList.astro';

export const prerender = true;

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
	const posts = await getCollection('insights', (p) => !p.data.draft);
	posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
	return paginate(posts, { pageSize: POSTS_PER_PAGE }); // /insights, /insights/2, ...
};

type PageProp = {
	data: CollectionEntry<'insights'>[];
	url: { prev?: string; next?: string };
	currentPage: number;
	lastPage: number;
};

const { page } = Astro.props as { page: PageProp };
const hasItems = page.data.length > 0;
const showPrev = hasItems && Boolean(page.url.prev);
const showNext = hasItems && Boolean(page.url.next);
---

<Base
	title="Insights"
	description="Latest articles and notes."
	noindex={page.currentPage > 1}
	*
	Optional:
	set
	to
	false
	if
	you
	want
	page
	2+
	indexed
	*
>
	<Fragment slot="head">
		{showPrev && <link rel="prev" href={page.url.prev!} />}
		{showNext && <link rel="next" href={page.url.next!} />}
		{
			/*
      Canonical is handled by SEO.astro (self-referential). If you ever want a custom canonical,
      pass `canonical` to <Base> instead of adding another <link> here.
    */
		}
	</Fragment>

	<h1>Insights</h1>

	<InsightsList entries={page.data} />

	{
		hasItems && (showPrev || showNext) && (
			<nav aria-label="Pagination" class="pagination">
				{showPrev && (
					<a href={page.url.prev} rel="prev" aria-label="Newer posts">
						← Newer
					</a>
				)}
				{showNext && (
					<a href={page.url.next} rel="next" aria-label="Older posts">
						Older →
					</a>
				)}
			</nav>
		)
	}
</Base>
