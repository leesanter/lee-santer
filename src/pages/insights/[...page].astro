---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { POSTS_PER_PAGE } from '../../lib/constants';

export async function getStaticPaths({ paginate }) {
	const posts = await getCollection('insights', (p) => !p.data.draft);
	posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
	return paginate(posts, { pageSize: POSTS_PER_PAGE }); // /insights, /insights/2, ...
}

const { page } = Astro.props;
---

<Base>
	<h1>Insights</h1>
	<ul>
		{
			page.data.map((p) => (
				<li>
					<a href={`/insights/${p.slug}`}>
						{p.data.featuredImage && (
							<img src={p.data.featuredImage.src} alt={p.data.featuredAlt || ''} />
						)}
						<h2>{p.data.title}</h2>
						<p>{p.data.summary}</p>
					</a>
				</li>
			))
		}
	</ul>

	<nav aria-label="pagination">
		{page.url.prev && <a href={page.url.prev}>← Newer</a>}
		{page.url.next && <a href={page.url.next}>Older →</a>}
	</nav>
</Base>
