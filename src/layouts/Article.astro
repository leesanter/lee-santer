---
/* ======================================================================
   Article.astro — layout for content pages (blog, docs, etc.)
   - Wraps Base.astro; applies .prose styling to the article content
   - Accepts SEO props, hero image, and metadata (publish/updated)
   - Usage: see /src/pages/blog/[...slug].astro
====================================================================== */
import Base from './Base.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	description?: string;
	heroImage?: ImageMetadata | string; // ← allow string or asset
	ogImage?: ImageMetadata | string;
	canonical?: string;
	publishedTime?: string;
	modifiedTime?: string;
}

const { title, description, heroImage, ogImage, canonical, publishedTime, modifiedTime } =
	Astro.props as Props;

// Coerce hero to a URL string; detect if we have an asset
const heroSrc = typeof heroImage === 'string' ? heroImage : heroImage?.src;
const hasHeroAsset = typeof heroImage !== 'string' && !!heroImage;

// Define pageClass if Base expects it (remove this + prop if not needed)
const pageClass: string | undefined = undefined;
---

<Base
	{title}
	{description}
	{canonical}
	ogImage={ogImage}
	type="article"
	publishedTime={publishedTime}
	modifiedTime={modifiedTime}
	pageClass={pageClass}
>
	<section class="container container--large section--first">
		<article class="article prose stack large">
			<header class="article__header stack small">
				<h1 class="h1">{title}</h1>
				{description && <p class="text-medium">{description}</p>}
				{
					(publishedTime || modifiedTime) && (
						<p class="text-small text-mid">
							{publishedTime && (
								<time datetime={publishedTime}>
									Published {new Date(publishedTime).toLocaleDateString()}
								</time>
							)}
							{publishedTime && modifiedTime && ' · '}
							{modifiedTime && (
								<time datetime={modifiedTime}>
									Updated {new Date(modifiedTime).toLocaleDateString()}
								</time>
							)}
						</p>
					)
				}
			</header>

			{
				hasHeroAsset ? (
					<figure class="article-hero">
						<Image
							src={heroImage as ImageMetadata}
							alt={title}
							widths={[640, 960, 1280, 1600]}
							sizes="(min-width: 992px) 960px, 100vw"
							loading="eager"
							decoding="async"
						/>
					</figure>
				) : (
					heroSrc && (
						<figure class="article-hero">
							<img src={heroSrc} alt={title} loading="eager" decoding="async" />
						</figure>
					)
				)
			}

			<div class="article__content">
				<slot />
			</div>
		</article>
	</section>
</Base>

<style lang="scss">
	/* Article-specific tweaks (inherits your global .prose styles) */
	.article__hero {
		margin-block: var(--size--large);
		img {
			display: block;
			width: 100%;
			height: auto;
			border-radius: 0.5rem;
		}
	}

	.article-hero {
		margin-block: var(--size--large);
	}
	.article-hero img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius--medium);
	}
</style>
