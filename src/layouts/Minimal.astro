---
/* Minimal.astro — thin wrapper over Base (no header/footer) */
import Base from './Base.astro';

// Forward everything, but force-hide header/footer.
const props = Astro.props as Record<string, any>;
---

<Base
	{...props}
	seoImage={props.seoImage ?? props.ogImage /* back-compat */}
	showHeader={false}
	showFooter={false}
>
	<slot slot="head" />
	<slot />
</Base>
