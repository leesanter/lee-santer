---
/* ======================================================================
   Base.astro — site shell/layout
   - Imports main.scss once
   - SEO + shared head assets (favicons/manifest/theme-color)
   - Semantic landmarks + skip link
====================================================================== */

import '../styles/main.scss';
import SEO from '../components/utils/SEO.astro';
import HeadAssets from '../components/utils/HeadAssets.astro';
import FontAssets from '../components/utils/FontAssets.astro';

import SiteHeader from '../components/organisms/SiteHeader.astro';
import SiteFooter from '../components/organisms/SiteFooter.astro';
import ScrollListener from '../components/utils/ScrollListener.astro';
import CookieConsent from '../components/utils/CookieConsent.astro';
import MotionController from '../components/utils/MotionController.astro';

const ENV = import.meta.env;
const fontPreloads = (ENV.PUBLIC_FONT_PRELOADS || '')
	.split(',')
	.map((s) => s.trim())
	.filter(Boolean);
const HTML_LANG = ENV.PUBLIC_HTML_LANG ?? 'en-GB';

const {
	title,
	description,
	canonical,
	noindex = false,
	pageClass = '',
	structuredData, // kept for back-compat
	ogImage, // legacy alias
	type, // 'website' | 'article' | 'creativework'
	publishedTime,
	modifiedTime,

	// NEW: preferred names
	seoImage, // string | ImageMetadata
	seoTitleTemplate, // e.g. "%s | Freelance Web & Brand Designer in Kent"
	seoAppendSiteName = 'auto', // boolean | 'auto'

	headerOverlay = 'auto', // NEW
} = Astro.props;

// Prefer new seoImage; fall back to ogImage for back-compat
const image = seoImage ?? ogImage;
---

<!doctype html>
<!-- Base.astro outer html element -->
<html lang={HTML_LANG} data-scheme={Astro.props.schemeHint /* 'dark' | 'light' */}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<SEO
			title={title}
			description={description}
			canonical={canonical}
			noindex={noindex}
			image={image}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			structuredData={structuredData}
			titleTemplate={seoTitleTemplate}
			appendSiteName={seoAppendSiteName}
		/>

		<FontAssets files={fontPreloads.length ? fontPreloads : undefined} />
		<HeadAssets />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-to-content" href="#main">Skip to content</a>

		<div class="page-wrapper">
			<SiteHeader overlay={headerOverlay} />
			<main id="main" class:list={['main-wrapper', pageClass]} tabindex="-1">
				<slot />
			</main>
			<SiteFooter />

			<ScrollListener />
			<MotionController />
			<CookieConsent />
		</div>
	</body>
</html>
